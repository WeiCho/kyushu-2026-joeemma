{%- macro money(v) -%}{{ trip.currency }}{{ "{:,.0f}".format(v) }}{%- endmacro -%}
{#- 緊急卡片的圖示。24×24、stroke 2、round cap/join、吃 currentColor，
    所以深淺色與列印都自動跟著走，也不需要外部檔（單檔可攜）。
    順序對應 trip.emergency：警察／救護／外交部／駐辦／包車／保險 -#}
{%- macro em_icon(i) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if i == 0 -%}<path d="M12 3 4 6v6c0 4.5 3.2 7.6 8 9 4.8-1.4 8-4.5 8-9V6z"/>
{%- elif i == 1 -%}<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>
{%- elif i == 2 -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><ellipse cx="12" cy="12" rx="4" ry="9"/>
{%- elif i == 3 -%}<path d="M3 21h18M4 10h16M12 3 3 8h18zM7 10v11M11 10v11M15 10v11M19 10v11"/>
{%- elif i == 4 -%}<path d="M3 16V9a1 1 0 0 1 1-1h8l4 4h3a1 1 0 0 1 1 1v3"/><path d="M3 16h2M9 16h6M19 16h2"/><circle cx="7" cy="16.5" r="2"/><circle cx="17" cy="16.5" r="2"/>
{%- else -%}<path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9z"/><path d="M12 12v6a3 3 0 0 0 6 0"/>
{%- endif -%}
</svg>
{%- endmacro -%}
{#- 銜接引子：交代下一區「為何是下一區」，整行可點。
    只用在確實有邏輯關係的兩處；緊急→行程那一跳沒有邏輯關係，
    刻意不放，交給該區既有的深→淺色彩轉場撐住 -#}
{%- macro handoff(lead, anchor, label) -%}
<div class="handoff"><a href="#{{ anchor }}">{{ lead }}<b>{{ label }}&nbsp;→</b></a></div>
{%- endmacro -%}
{%- set TYPE_META = {
  "景點": {"icon": "🏛", "cls": "t-see"},
  "餐廳": {"icon": "🍜", "cls": "t-eat"},
  "交通": {"icon": "🚃", "cls": "t-go"},
  "住宿": {"icon": "🏨", "cls": "t-stay"},
  "購物": {"icon": "🛍", "cls": "t-shop"},
} -%}
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ trip.title }}｜旅程手冊</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#191d1a" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="{{ trip.hero_word or trip.title }}">
<link rel="apple-touch-icon" href="icon.svg">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<script>
/* 早期套用主題與字級偏好，避免載入閃爍。亮色為預設；深色/大字為選用 */
(function(){var d=document.documentElement;
  // 有 JS 才收合（換日、工具列、浮卡）。沒有這個 class，CSS 一律展開全部內容
  d.className += " js";
  try{
  var t=localStorage.getItem("theme")||(window.matchMedia&&matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light");
  d.setAttribute("data-theme",t);
  if(localStorage.getItem("textsize")==="large")d.setAttribute("data-theme-size","large");
}catch(e){d.setAttribute("data-theme","light");}})();
</script>
<style>
/* ══════════════════════════════════════════════════════════════
   版面語法取自 3jigen.jp、字形語法取自 tau-kumamoto.com（皆為實地量測）
     · 黑體（筑紫ゴシック Pro B 的在地替代），全站 font-weight 600
     · 行高 1.8，字距多為 normal，列表標題 0.15em
     · 一條 0.8px #d6d6ce 細線貫穿全站，圓角只有 4px
     · 深色段落用直向漸層，隨捲動由兩側往外展開
   ══════════════════════════════════════════════════════════════ */
:root{
  --paper:#f4f4f2;      /* 紙 */
  --ink:#2d2519;        /* 墨（也是深色區塊底色） */
  --line:#d6d6ce;       /* 全站唯一分隔線 */
  --card:#ffffff;       /* 卡片白 */
  --muted:#6b6259;      /* 次要字 */
  --warm:#8c2f22;       /* 警示：唯一功能色 */
  --focus:#8c2f22;
  --pine:#2d2519;       /* 實心按鈕底 */
  --sage:#ebe9e3;       /* 淺底（編輯器區塊標題） */
  --hair-dark:rgba(255,255,255,.26);
  /* 與 --paper 同色但全透明。直接對 transparent 漸層在 sRGB 下會透出灰邊 */
  --paper-0:rgba(244,244,242,0);

  /* 筑紫ゴシック Pro B 的在地替代。繁中字面排前面，避免逐字掉字型 */
  --sans:"Noto Sans TC","Source Han Sans TC","PingFang TC","Microsoft JhengHei",
         "Hiragino Sans","Yu Gothic UI","Noto Sans JP",sans-serif;
  --serif:var(--sans);              /* 這套語言沒有襯線；沿用同一顆字 */
  --latin:"DIN Next LT Pro","DIN Next",Roboto,"Helvetica Neue",Arial,sans-serif;

  --w:600;              /* 實測全站字重 */
  --gut:clamp(18px,4.2vw,64px);
  --sec:clamp(72px,11vh,140px);   /* 章節上下留白，也決定帶與帶之間的呼吸 */
  /* 緊急區下緣淡出的高度。刻意與 --sec 脫鉤：留白是節奏，漸層是質感，
     兩者共用同一個變數的話，調節奏就會把那道轉場一起縮短、露出硬邊 */
  --ease:cubic-bezier(.16,1,.3,1);
}

/* ── 深色模式（選用；亮色仍為預設與識別）── */
:root[data-theme="dark"]{
  --paper:#17130d; --ink:#ece7dd; --line:#3a342b; --card:#221c14;
  --muted:#a49a8c; --warm:#e08a72; --focus:#e08a72; --pine:#ece7dd; --sage:#221c14;
  --paper-0:rgba(23,19,13,0);
}
:root[data-theme="dark"] .cta .o,
:root[data-theme="dark"] .now-go{background:var(--ink);color:var(--paper)}
:root[data-theme="dark"] .card-live{background:var(--card)}

/* ── 長輩模式（放大關鍵閱讀文字 + 更高對比）── */
:root[data-theme-size="large"]{--muted:#4a4239}
:root[data-theme="dark"][data-theme-size="large"]{--muted:#cdc4b6}
[data-theme-size="large"] body{font-size:19px}
[data-theme-size="large"] .lead{font-size:20px}
[data-theme-size="large"] .sticky-nav a{font-size:17px}
[data-theme-size="large"] .stop time{font-size:26px}
[data-theme-size="large"] .stop h4{font-size:20px}
[data-theme-size="large"] .stop .desc{font-size:17px}
[data-theme-size="large"] .stop .meta{font-size:16px}
[data-theme-size="large"] .day-weather,
[data-theme-size="large"] .day-note{font-size:16px}
[data-theme-size="large"] .check-grid>div,
[data-theme-size="large"] .emergency-grid p,
[data-theme-size="large"] .pending-banner li{font-size:17px}
[data-theme-size="large"] .emergency-grid a.tel{font-size:18px}
/* 緊急卡片與彈窗也要跟著放大：會開大字模式的人，正是最需要看清電話的人。
   卡片原本用固定 aspect-ratio 定高，字級一放大長名稱會折三行撐破，
   所以大字模式改用 min-height 讓卡片自己長高 */
[data-theme-size="large"] .em-card{aspect-ratio:auto;min-height:215px}
[data-theme-size="large"] .em-name{font-size:17px}
[data-theme-size="large"] .em-dlg h3{font-size:21px}
[data-theme-size="large"] .em-dlg .em-desc{font-size:17px}
[data-theme-size="large"] .em-meta{font-size:16px}
[data-theme-size="large"] .em-tel{font-size:30px}
[data-theme-size="large"] .em-todo-tag{font-size:15px}
[data-theme-size="large"] .pack-items label{font-size:18px}
/* 放大後行高照 1.8 會塞不下幾項，整體收緊一級 */
[data-theme-size="large"] body{line-height:1.7}
[data-theme-size="large"] .stop p{line-height:1.75}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:5.5rem}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-weight:var(--w);
  font-size:17px;line-height:1.8;letter-spacing:normal;
  -webkit-font-smoothing:antialiased;
}
@media (width<=820px){ body{font-size:16px} }
a{color:inherit}
a:focus-visible,button:focus-visible,summary:focus-visible{
  outline:3px solid var(--focus);outline-offset:3px;border-radius:4px;
}
h1,h2,h3,h4{font-weight:var(--w);margin:0}
.lat{font-family:var(--latin)}

/* 跳過導覽：整頁 46 個焦點，原本前四個是封面浮卡（裝飾性浮層）。
   平常收在畫面外，取得焦點才滑進來；外觀沿用全站既有的邊框與圓角 */
.skip{
  position:fixed;left:var(--gut);top:12px;z-index:60;
  display:inline-flex;align-items:center;min-height:44px;padding:0 18px;
  background:var(--card);border:.8px solid var(--line);border-radius:4px;
  text-decoration:none;font-size:15px;letter-spacing:.06em;
  transform:translateY(-200%);transition:transform .25s var(--ease);
}
.skip:focus{transform:none}

.wrap{max-width:1440px;margin:0 auto;padding-inline:var(--gut)}

/* ── 固定頂列（無字標，導覽靠右）── */
/* 照 sukima.tokyo.jp：導覽永遠固定在同一個位置、永遠透明、沒有底色 bar。
   壓在深色塊上時只翻文字顏色（見 .over-dark），不做任何底色或版型切換 */
.sticky-nav{
  position:fixed;inset:0 0 auto;z-index:40;width:100%;
  pointer-events:none;   /* 透明的滿版容器不該擋住底下的內容 */
}
/* 面板也要收事件，否則點到它的內距會被當成「點外面」而關掉選單 */
.sticky-nav a,.sticky-nav button,.sticky-nav .tools-menu{pointer-events:auto}
.sticky-nav>.nav-inner{
  max-width:1440px;margin:0 auto;
  display:flex;justify-content:flex-end;align-items:center;gap:clamp(12px,2vw,28px);
  padding:clamp(12px,2.2vh,20px) var(--gut);
}
/* 不用 mix-blend-mode：它只有掛在 .sticky-nav 本身才會對頁面生效（position:fixed
   會建立堆疊脈絡、隔離子元素的混色），而掛在 nav 上會把工具選單那塊實心紙色面板
   一起反相成灰藍、圖示消失。改成只在導覽真的壓到深色塊時翻文字顏色——
   沒有底色、沒有 bar、位置完全不動 */
.sticky-nav.over-dark{color:#fff}
/* 選單面板有自己的紙色底，不能跟著翻白 */
.sticky-nav.over-dark .tools-menu{color:var(--ink)}
.nav-links{display:flex;gap:clamp(14px,2.2vw,30px);overflow-x:auto;scrollbar-width:none}
.nav-links::-webkit-scrollbar{display:none}
.sticky-nav a{
  /* 點擊區撐足 44px：實測原本只有 32×27，是全頁最小的目標，
     而且位在手機最難按的右上角。頂列左側大半是空的，加高不影響版面 */
  display:inline-flex;align-items:center;min-height:44px;
  text-decoration:none;font-size:16px;letter-spacing:.06em;line-height:1.5;
  white-space:nowrap;padding:10px 0;position:relative;
}
.sticky-nav a::after{
  /* 底線跟著文字走，不要跟著加高後的點擊區跑到下緣 */
  content:"";position:absolute;left:0;right:100%;bottom:9px;height:.8px;background:currentColor;
  transition:right .5s var(--ease);
}
.sticky-nav a:hover::after,.sticky-nav a:focus-visible::after,
.sticky-nav a.active::after{right:0}
/* 工具列：三顆鈕收進一顆三條線圖示，點開才展開。沒有 JS 時三顆直接並排 */
.nav-tools{position:relative;flex:0 0 auto}
.tools-toggle{display:none}
/* 三條線本身就是圖示，不加外框；點擊區用 padding 撐足 44px */
.js .tools-toggle{
  display:flex;flex-direction:column;justify-content:center;align-items:flex-end;gap:5px;
  width:44px;height:44px;padding:0;border:0;border-radius:0;
  background:transparent;color:inherit;cursor:pointer;
}
.tools-toggle i{
  display:block;width:22px;height:1.2px;background:currentColor;
  transition:transform .35s var(--ease),opacity .35s var(--ease),width .35s var(--ease);
}
.tools-toggle i:nth-child(2){width:16px}
.js .tools-toggle:hover i:nth-child(2){width:22px}
/* 展開時收成一個叉 */
.js .tools-toggle[aria-expanded="true"] i:nth-child(1){transform:translateY(6.2px) rotate(45deg)}
.js .tools-toggle[aria-expanded="true"] i:nth-child(2){opacity:0}
.js .tools-toggle[aria-expanded="true"] i:nth-child(3){transform:translateY(-6.2px) rotate(-45deg);width:22px}
.tools-menu{display:flex;gap:8px}
.js .tools-menu{
  position:absolute;top:calc(100% + 8px);right:0;flex-direction:column;
  background:var(--paper);border:.8px solid var(--line);border-radius:4px;padding:8px;
  box-shadow:0 2px 14px rgba(45,37,25,.09);
}
.js .tools-menu[hidden]{display:none}
.nav-tool{
  min-width:38px;min-height:38px;border-radius:4px;border:.8px solid currentColor;
  background:transparent;color:inherit;font:inherit;font-size:14px;cursor:pointer;
  display:grid;place-items:center;opacity:.75;
}
.nav-tool:hover{opacity:1}

/* ── 垂直導覽：從頭到尾都是這個樣子，不隨捲動改變 ── */
/* 對齊 1440 版心而不是視窗邊緣（sukima 是貼邊）：封面的構圖建立在版心上，
   標語左緣、照片置中、導覽右緣是同一組對稱，貼邊會在寬螢幕上脫節 */
@media (width>860px){
  .sticky-nav>.nav-inner{
    flex-direction:column;align-items:flex-end;gap:clamp(6px,1.2vh,14px);
    padding-top:clamp(40px,7vh,64px);
  }
  .sticky-nav .nav-links{
    flex-direction:column;align-items:flex-end;gap:clamp(2px,.6vh,8px);
    overflow:visible;   /* 垂直排列時橫向捲動沒有意義，且會裁掉底線動畫 */
  }
  /* 垂直排時 44px 會把五條拉得太開，滑鼠操作收成 36px */
  .sticky-nav a{min-height:36px;padding:6px 0}
  .sticky-nav a::after{bottom:5px}
  /* 但觸控裝置（例如寬度落在桌機版型的平板）要回到 44×44。
     往左加內距而不是往右，文字的右緣對齊才不會被推走 */
  @media (pointer:coarse){
    .sticky-nav a{min-height:44px;padding:10px 0 10px 12px}
    .sticky-nav a::after{bottom:9px;left:12px}
  }
}

@media (width<=860px){
  .sticky-nav a{font-size:15px}
  .nav-links{gap:16px}
  .nav-tool{min-width:38px;min-height:38px;font-size:13px}
  /* 手機：列上只留「緊急」，其餘四條移進抽屜（見 .drawer-links） */
  .nav-links a:not(.nav-urgent){display:none}
  .sticky-nav>.nav-inner{justify-content:flex-end;gap:14px}
  .nav-links:empty{display:none}
}
/* 抽屜裡的導覽：桌機不存在（列上已經有了），手機才顯示，
   和底下三顆工具鍵用一條細線分成「去哪裡」與「怎麼看」兩組 */
.drawer-links{display:none}
@media (width<=860px){
  .js .drawer-links{
    display:flex;flex-direction:column;align-items:stretch;
    margin:0 0 8px;padding-bottom:8px;border-bottom:.8px solid var(--line);
  }
  .js .drawer-links a{font-size:15px;min-height:40px;padding:6px 4px;white-space:nowrap}
  .js .drawer-links a::after{display:none}   /* 抽屜裡不需要底線動畫 */
  /* 抽屜變寬一點，四條連結才不會擠成一條窄柱 */
  .js .tools-menu{min-width:132px}
  .js .tools-menu .nav-tool{width:100%}
}

/* ── Hero ── */
/* 照 giftee.co.jp 的封面：三欄——標語靠左、照片水平置中、導覽疊在右上。
   照片是唯一的視覺主角，標語刻意用小字＋極寬字距退到背景。
   1fr auto 1fr 的兩側等寬，照片才會真的落在視窗正中，而不是版心正中 */
.hero{
  min-height:100svh;display:grid;align-content:center;align-items:center;
  grid-template-columns:1fr auto 1fr;
  max-width:1440px;margin-inline:auto;
  padding:clamp(96px,14vh,140px) var(--gut) clamp(56px,10vh,110px);
}
.hero-copy{grid-column:1;justify-self:start;text-align:left}
.hero-figure{grid-column:2;margin:0}
.hero-figure img{
  /* 照 giftee：精確 2:3、無圓角。用視窗寬定尺寸（實測 giftee 約佔 22vw），
     再用 svh 封頂，矮螢幕上照片才不會頂破封面的一個畫面 */
  display:block;width:clamp(240px,23vw,340px);height:auto;
  aspect-ratio:2/3;max-height:72svh;object-fit:cover;
  /* 不加任何濾鏡：深色照片壓在米白紙上正是這個版面的特徵，不是缺陷 */
}
.hero h1{
  /* giftee 實測：字距 0.4em、字重 400（Regular）、字級只有 21px。
     字級不照抄——它的主角是自家拍的照片，標語只是註腳；這裡的標題本身
     才是記憶點，縮到 21px 會被一張借來的風景照壓掉 */
  text-align:left;font-size:clamp(28px,3.2vw,44px);
  letter-spacing:.4em;font-weight:400;line-height:1.7;
}

/* 沒有三欄空間就疊起來。giftee 手機版（≤991px）也是 flex-direction:column，
   標語在上、照片在下，而且標語貼近頂部（實測距頂 77px）不置中 */
@media (width<=860px){
  .hero{
    grid-template-columns:1fr;align-content:start;
    gap:clamp(28px,5vh,48px);
    padding:clamp(76px,11vh,104px) var(--gut) clamp(40px,6vh,72px);
  }
  .hero-copy,.hero-figure{grid-column:1;justify-self:start}
  .hero h1{font-size:clamp(26px,6.4vw,40px);letter-spacing:.3em}
  /* 標語靠上之後，剩下的高度全部給照片——照片成為手機封面的主體 */
  .hero-figure img{width:auto;height:min(52svh,460px);max-height:none}
}

/* ── 封面浮卡（可疊多張，往左滑換下一張）── */
/* 浮在右下角（取自 3jigen.jp 的 Pick Up 卡）。
   沒有 JS 時退回文流內、一張張往下排的一般卡片，不會變成蓋住內容的浮層 */
.card-deck{
  /* 卡片內容區固定 215×125（--live-box），外面再加 16 內距與 .8 邊框。
     215 是量 iOS 的結果：PingFang 比 Windows 的字寬，210 會讓摘要多折一行 */
  --live-box:calc(215px + 32px + 1.6px);
  --live-h:calc(125px + 32px + 1.6px);
  width:min(var(--live-box),100%);margin:clamp(26px,4.5vh,48px) auto 0;
  display:grid;gap:12px;
}
.card-live{
  width:100%;min-height:var(--live-h);
  background:var(--card);border:.8px solid var(--line);border-radius:4px;
  padding:16px;text-align:left;   /* 四邊等寬，卡片內不做左右差 */
}
.js .card-deck{
  /* 右緣對齊內容區右緣：章節是 max-width 1440 置中再加左右留白，
     所以右邊要留「置中剩餘的一半 + 留白」，寬螢幕才不會比文字更靠邊 */
  position:fixed;right:calc((100% - min(100%,1440px)) / 2 + var(--gut));
  bottom:calc(24px + var(--nowbar-h, 0px));z-index:35;margin:0;display:block;
  width:min(var(--live-box),calc(100% - var(--gut)*2));
  height:var(--live-h);
  touch-action:pan-y;   /* 左右手勢留給換卡，上下仍可正常捲頁 */
}
/* 疊在一起：只有最上面那張完全顯示，後面的往上縮一點露出邊 */
.js .card-deck .card-live{
  position:absolute;inset:0;margin:0;
  box-shadow:0 2px 14px rgba(45,37,25,.09);
  transform:translate3d(0,var(--dy,0),0) scale(var(--sc,1));
  opacity:var(--op,1);z-index:var(--z,1);
  transition:transform .42s var(--ease),opacity .42s var(--ease);
}
.js .card-deck .card-live.is-dragging{transition:none}
/* 頁碼點：也可直接點著換卡（桌機沒有滑動手勢時用得到） */
.deck-dots{display:none}
.js .card-deck .deck-dots{
  display:flex;gap:6px;position:absolute;right:16px;bottom:-16px;z-index:36;
}
.js .deck-dots button{
  width:16px;height:16px;padding:0;border:0;background:transparent;cursor:pointer;
  display:grid;place-items:center;
}
.js .deck-dots button::before{
  content:"";width:5px;height:5px;border-radius:50%;background:var(--muted);opacity:.7;
  transition:background .3s var(--ease);
}
.js .deck-dots button[aria-current="true"]::before{background:var(--ink);opacity:1}
@media (prefers-reduced-motion:no-preference){
  .js .card-deck{
    opacity:0;transform:translateY(16px);
    transition:opacity .55s var(--ease),transform .55s var(--ease);
  }
  .js .card-deck.is-in{opacity:1;transform:none}
  /* 開始往下捲就退場 */
  .js .card-deck.is-out{opacity:0;transform:translateY(16px)}
}
.js .card-deck.is-out{pointer-events:none;visibility:hidden}
.card-live .top{padding-bottom:7px;border-bottom:.8px solid var(--line)}
/* 標題不截字：寧可換行也不要出現「…」 */
.card-live .who{font-size:14.5px;letter-spacing:.04em}
.card-live .who::before{content:"●";font-size:7px;vertical-align:3px;margin-right:.6em}
/* 日期跟在狀態右邊（只到日，不寫時間）：卡片窄，這樣少一行 */
.card-live .upd{
  margin-left:.7em;font-family:var(--latin);font-size:12.5px;color:var(--muted);
  white-space:nowrap;
}
.card-live .state{margin:9px 0 0;font-size:15.5px;line-height:1.65}
/* 手動標記（如訂位開賣日），跟在日期後面，用暖色點出來 */
.card-live .live-tag{
  margin-left:.5em;padding:1px 7px;border:.8px solid var(--warm);border-radius:4px;
  color:var(--warm);font-size:12px;letter-spacing:.04em;white-space:nowrap;
}
.card-live .keys{
  /* 13.5 而非 14：iOS 的 PingFang 比桌機字寬，14 會讓摘要在 215 寬裡多折一行 */
  margin:4px 0 0;font-size:13.5px;line-height:1.75;color:var(--muted);
  /* 不截字：內容由 scripts/update_takachiho.py 濃縮成兩行短句，這裡完整顯示 */
  white-space:pre-line;
}
.card-live a.who{text-decoration:none;border-bottom:.8px solid var(--line)}
.card-live a.who:hover{border-color:currentColor}

/* ── 章節 ── */
.section{max-width:1440px;margin:0 auto;padding:var(--sec) var(--gut) 0}
.section-heading{margin-bottom:clamp(28px,5vh,60px)}
.section-heading h2{font-size:clamp(26px,3.2vw,38px);line-height:1.4;letter-spacing:.1em}
.section-heading p{
  margin:6px 0 0;color:var(--muted);font-size:15px;letter-spacing:.04em;line-height:1.8;
}
/* ── 銜接引子（.handoff）與頁尾收束（.coda）──
   兩者都只用全站唯一的 0.8px 細線與既有的下劃線動效，不引入新視覺 */
.handoff{margin-top:clamp(40px,6vh,72px);border-top:.8px solid var(--line);display:flex;justify-content:flex-end}
.handoff a{
  position:relative;display:inline-flex;align-items:baseline;gap:1em;
  padding:19px 0;min-height:44px;   /* 點擊區撐足 44 */
  text-decoration:none;color:var(--muted);font-size:15px;letter-spacing:.06em;
}
.handoff a b{font-weight:var(--w);color:var(--ink)}
/* 與導覽列同一手：底線由左往右長出來 */
.handoff a::after{
  content:"";position:absolute;left:0;right:100%;bottom:13px;height:.8px;background:currentColor;
  transition:right .5s var(--ease);
}
.handoff a:hover::after,.handoff a:focus-visible::after{right:0}

.coda{max-width:1440px;margin:0 auto;padding-inline:var(--gut)}
.coda>div{
  border-top:.8px solid var(--line);
  padding:clamp(40px,6vh,72px) 0 clamp(48px,8vh,96px);
  display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap;
}
.coda .d{font-size:14px;letter-spacing:.08em;color:var(--muted)}
.coda .t{font-size:15.5px;letter-spacing:.1em}

.heading-row{
  display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;
}

/* ── 區塊分帶 ──
   一個帶＝一種底色，相關的章節歸在同一帶：
     A 緊急（深色）　B 行程　C 花費　E 提醒＋檢查
   帶與帶直接相接，不留空白段：換色在下一帶開頭的那一小段裡完成
   （--prev → --band 的漸層），所以既沒有硬邊，也不會出現一塊空的過場。 */
/* 帶的底色不做左右展開：那會讓帶的第一個章節出現時露出兩側較窄的色塊，
   跟帶中間的章節看起來不一樣。左右展開只留給深色那一塊，
   其餘一律「底色滿版、內容淡入」。 */
.band{position:relative}
.band::before{
  content:"";position:absolute;inset:0;z-index:0;
  /* background-color 保留單一色值：頂列要靠它取此刻壓在底下的底色 */
  background-color:var(--band);
  background-image:linear-gradient(180deg,var(--prev,var(--band)) 0,var(--band) clamp(120px,20vh,260px));
}
.band>*{position:relative;z-index:1}
/* 每個章節各自淡入，所以帶裡的第二個章節（檢查）不會一開始就出現 */
.section{opacity:var(--fade,1)}
/* 上一帶的底色（--prev）就是上面那一帶的 --band，改色時兩處要一起改 */
.band-b{--band:#f2f1ed; --prev:#f2f1ed}
.band-c{--band:#eceae3; --prev:#f2f1ed}
.band-e{--band:#eae7e0; --prev:#eceae3}
:root[data-theme="dark"] .band-b{--band:#1b1610; --prev:#1b1610}
:root[data-theme="dark"] .band-c{--band:#201a13; --prev:#1b1610}
:root[data-theme="dark"] .band-e{--band:#1e1913; --prev:#201a13}

/* ── 待確認橫幅 ── */
.pending-banner{max-width:1440px;margin:0 auto;padding:clamp(80px,12vh,120px) var(--gut) 0}
.pending-banner details{border:.8px solid var(--warm);border-radius:4px;padding:14px 16px}
.pending-banner summary{cursor:pointer;color:var(--warm);font-size:15.5px;letter-spacing:.06em}
.pending-banner ul{margin:10px 0 0;padding-left:1.2em}
.pending-banner li{font-size:15px;line-height:1.85;color:var(--muted)}
.pending-banner a{color:var(--ink)}

/* ── 緊急（深色首區）：底色漸層並隨捲動由中間往兩側展開 ──
   手法取自 3jigen.jp 首圖的 `clip-path: inset(0 X%)`，X 由 22% 收到 0。
   clip 掛在背景層（::before），文字另外淡入 —— 整塊裁切會把文字從中間切斷。
   --open / --fade 的預設值就是「完全展開」，所以沒有 JS 或使用者要求減少動態時，
   畫面直接是最終狀態，不會整區空白。 */
#emergency{
  position:relative;color:#fff;max-width:none;
  /* 整塊比一般章節再厚一點：上下留白拉到 1.35 倍，下緣還要留給淡出 */
  margin-top:var(--sec);padding:calc(var(--sec) * 1.35) 0;
  --open:0%;
  --fade:1;
}
/* 底色改採 kobe-yakult.co.jp 頁尾「Contact Us」那種區塊：純色、圓角、四周內縮，
   不再是滿版漸層。原本的三層漸層（下緣淡出＋左上放射光暈＋垂直深→淺）全部拿掉——
   圓角色塊是「一塊放在紙上的東西」，有明確的邊，沒有溶進下一區這回事。
   附帶好處：白字對比從漸層最亮端的 6.47:1 提升到 12.75:1。 */
/* 內縮量：有上限的固定值。曾經試過綁在版心邊距上（讓導覽永遠避開色塊），
   但那個值會隨視窗寬無上限成長——1920 下算出 371px，卡片被壓到 83px、
   名稱折三行，整區崩掉。
   改成相反的策略：導覽不閃避，而是永遠完整落在色塊「內」，重疊交給
   .over-dark 翻文字顏色處理。3.4vw 恆小於 --gut 的 4.2vw，所以導覽的
   左右緣都在色塊裡，不會發生「一半在深底一半在淺底」的半截字 */
#emergency{--em-inset:clamp(16px,3.4vw,72px)}
#emergency::before{
  content:"";position:absolute;z-index:0;
  /* 左右內縮成一塊，上下切齊區塊自身的留白 */
  inset:0 var(--em-inset);
  /* 純色，不疊任何漸層。#3a3126 是原漸層的最深端，等同 kobe-yakult 的
     #303030 在這套暖色系裡的對應值（兩者對白字都是 13:1 上下） */
  background-color:#3a3126;
  /* 圓角要寫進 clip-path 而不是 border-radius：橫向展開動畫用的就是 clip-path，
     兩者並用時 clip-path 會把 border-radius 切成方角 */
  clip-path:inset(0 var(--open) round 20px);
}
#emergency>*{position:relative;z-index:1;opacity:var(--fade)}
/* 色塊內縮後，內容的左右留白要從「視窗邊緣」改成「色塊邊緣」起算，
   否則文字會貼著圓角邊。kobe-yakult 的作法也是色塊內縮 50 再加 50 內距 */
#emergency .ov-inner{max-width:1440px;margin:0 auto;padding-inline:calc(var(--gut) + var(--em-inset))}
/* 深色底上的欄位表：直線與次要文字都改白色系，否則會看不見 */
#emergency .em-head h2,#emergency .emergency-grid p{color:#fff}
/* 底色改純色 #3a3126 後，.86 對它是 9.87:1，餘裕比先前的漸層大得多 */
#emergency .em-head p,#emergency .emergency-grid b{color:rgba(255,255,255,.86)}
#emergency .emergency-grid{border-left-color:var(--hair-dark)}
#emergency .emergency-grid a.tel{color:#fff;border-bottom-color:var(--hair-dark)}
/* 卡片：深底上「淺一階」，不用純白卡——這一區的深色是全頁唯一的，
   捲動時靠它一眼認出「緊急在這裡」，壓六張白卡會把那個辨識度洗掉 */
#emergency .em-card{color:#fff}
/* .86 是這一區既有的次要文字濃度。底色改純色後對比大幅放寬（9.87:1），
   但仍沿用 .86 與同區其他次要文字一致 */
#emergency .em-sub{color:rgba(255,255,255,.86)}
#emergency .em-name{border-top-color:var(--hair-dark)}

/* ── 提醒（原本的提醒與備忘合併成這一區，可收合、預設收起）── */
/* 區塊銜接不畫橫線，改用底色與進場動畫區分 */
/* 不用 margin-top：這一區是帶裡的第一個元素，外邊距會被帶「擠」出去變成空白帶。
   需要的上留白由 .alerts-summary 的 padding-top 負責 */
.alerts-section{margin-top:0}
.alerts-summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;
  align-items:flex-start;gap:20px;padding-top:var(--sec)}
.alerts-summary::-webkit-details-marker{display:none}
.alerts-toggle{font-family:var(--latin);font-size:22px;color:var(--muted);flex:0 0 auto}
.alerts-section[open] .alerts-toggle{transform:rotate(45deg)}
.alerts-section .section-heading{margin-bottom:0}
.alerts-body{padding-top:clamp(20px,3.4vh,40px)}

/* ── 每日行程：左右換日 ── */
/* 換日列：放在當天內容之後，不畫上下線 */
.daybar{
  display:flex;align-items:center;justify-content:center;gap:clamp(18px,3vw,44px);
  padding-block:clamp(24px,4vh,48px) 0;
}
.arw{
  width:52px;height:52px;flex:0 0 auto;border-radius:50%;
  border:.8px solid var(--ink);background:transparent;color:var(--ink);
  font-family:var(--latin);font-size:17px;cursor:pointer;display:grid;place-items:center;
  transition:background .35s var(--ease),color .35s var(--ease),opacity .35s var(--ease);
}
.arw:hover:not(:disabled){background:var(--ink);color:var(--paper)}
.arw:disabled{opacity:.5;cursor:default}   /* .26 算出來 1.68:1，非文字元件要 3:1 */
.daybar .th{
  flex:0 1 auto;min-width:0;text-align:center;
  font-size:clamp(16px,1.6vw,20px);line-height:1.6;letter-spacing:.06em;
}
.daybar .today-badge{
  margin-left:.6em;font-size:12px;letter-spacing:.1em;color:var(--warm);
  border:.8px solid var(--warm);border-radius:4px;padding:1px 8px;white-space:nowrap;
}

/* 換日時面板高度會變，瀏覽器的 scroll anchoring 會自行補償捲動位置，
   跟「換完回到行程頂端」的定位打架。這裡關掉，位置一律由程式決定 */
.days{overflow-anchor:none}
.day{padding-top:clamp(24px,4vh,48px)}
/* 沒有 JS 時所有天照常顯示；有 JS 才切換 */
.js .day:not(.is-on){display:none}

.day-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(20px,3.4vh,38px)}
@media (width>=900px){
  /* 左欄放寬（日期與主題常換行），右欄相應變窄並往右推 */
  .day-grid{grid-template-columns:minmax(280px,.95fr) minmax(0,1.85fr);gap:clamp(44px,6vw,120px)}
  .day-aside{border-right:.8px solid var(--line);padding-right:clamp(22px,2.8vw,52px)}
}
.day-no{
  display:block;font-family:var(--latin);font-size:clamp(48px,7vw,100px);line-height:.95;
  letter-spacing:.01em;
}
.day-no small{
  display:block;font-family:var(--latin);font-size:15px;letter-spacing:.1em;
  margin-top:8px;color:var(--muted);
}
.day-aside h3{
  font-size:clamp(17px,1.6vw,21px);line-height:1.7;letter-spacing:.06em;margin:16px 0 0;
}
.day-weather{margin:14px 0 0;font-size:14px;line-height:1.8;color:var(--muted)}
/* 預報來源：比天氣本身再淡一階，換行自己站一行，不跟氣溫擠在一起 */
.wx-src{display:block;font-size:12px;letter-spacing:.04em;opacity:.72}
/* 當日小提醒：跟天氣同一種灰，字級一樣，只用行距分開 */
.day-note{margin:6px 0 0;font-size:14px;line-height:1.8;color:var(--muted)}
.day-tools{margin-top:16px}
.route-btn{
  display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 16px;
  border:.8px solid var(--ink);border-radius:4px;text-decoration:none;font-size:15px;
  letter-spacing:.06em;
}
.route-btn:hover{background:var(--ink);color:var(--paper)}
.route-cap{display:block;margin-top:8px;font-size:13px;color:var(--muted)}

/* ── 時間軸 ── */
.timeline{list-style:none;margin:0;padding:0}
.stop{
  display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(14px,2.2vw,36px);
  padding-block:clamp(18px,2.8vh,32px);border-bottom:.8px solid var(--line);
}
/* 每天的第一站與最後一站不畫線：那是日與日的邊界，不是站與站的分隔 */
.timeline .stop:last-child{border-bottom:0}
.stop time{
  font-family:var(--latin);font-size:clamp(22px,2.2vw,28px);line-height:1.35;
  letter-spacing:.03em;white-space:nowrap;
}
.stop h4{
  font-size:clamp(17px,1.5vw,19px);line-height:1.7;letter-spacing:.06em;margin-bottom:5px;
}
.stop .tico{margin-right:.45em}
.stop .name{text-decoration:none;border-bottom:.8px solid currentColor}
.stop .loc{
  margin-left:.6em;font-size:14px;letter-spacing:.04em;text-decoration:none;
  border-bottom:.8px solid var(--line);white-space:nowrap;
}
/* 行內連結的點擊區。手冊的使用情境是路上單手點，行高撐出來的 19px 太小 */
.stop .loc,.ls-foot a,.stop .go{display:inline-flex;align-items:center;min-height:32px}
@media (pointer:coarse){
  .stop .loc,.ls-foot a{min-height:44px}
  .stop .loc{margin-left:1em}
}
.stop .desc{margin:0;font-size:15.5px;line-height:1.85;max-width:42em;color:var(--muted)}
.stop .meta{
  margin:12px 0 0;font-size:14px;letter-spacing:.04em;color:var(--muted);
}
.stop .meta b{color:var(--ink);font-family:var(--latin);letter-spacing:.08em}
.stop .go{
  display:inline-block;margin-top:11px;font-size:13.5px;color:var(--muted);text-decoration:none;
}
.stop .go span{border-bottom:.8px solid var(--line);margin-left:.4em}
/* 今日模式：已過的行程壓低，但不隱藏 */
/* 已過行程：原本只用 opacity:.42 傳達，算出來只有 2.45:1，而且語意單靠明暗。
   改成「時間加刪除線 + 名稱降為次要字」，兩個訊號、且都達 AA */
.stop.past{opacity:1}
.stop.past>time{text-decoration:line-through;text-decoration-thickness:.8px}
.stop.past h4,.stop.past h4 a,.stop.past .desc,.stop.past .meta{color:var(--muted)}

/* 行程內的即時狀態區 */
.live-status{
  margin:14px 0 0;border:.8px solid var(--line);border-radius:4px;padding:14px 16px;
  background:var(--card);
}
.ls-head{
  display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 12px;
  padding-bottom:9px;border-bottom:.8px solid var(--line);
}
.ls-head>span:first-child{font-family:var(--latin);font-size:12.5px;color:var(--muted)}
.ls-badge{font-size:15.5px;letter-spacing:.06em}
.ls-detail{
  margin:11px 0 0;font-size:14.5px;line-height:1.8;color:var(--muted);white-space:pre-wrap;
  word-break:break-word;
}
.ls-foot{margin:10px 0 0;font-size:12.5px;color:var(--muted)}
.ls-foot a{color:inherit}

/* ── 緊急資訊 ── */
/* 版式參考 3jigen.jp 的 Company：左側大標題、中間一條直線、右側欄位表。
   列與列之間刻意不畫橫線（依指示），改用行距分隔 */
/* max-width 1160 是反推出來的：右欄 = 183×3 + 20×2 間距 + 78 內距 = 667，
   左欄 = 667 / 1.35 = 494，合計 1161。內容區有 1312 寬，不收窄的話卡片會被
   撐成 238px——那就不是 c-morinosato 的卡了。收窄後置中，兩邊各留約 76px */
.em-wrap{
  display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(24px,4vh,44px);
  max-width:1160px;margin-inline:auto;
}
@media (width>=900px){
  /* 照 c-morinosato 的左右比例（實測左 400／右 600）。左欄比原本寬得多，
     因為它現在裝的是「標題＋副標＋說明」三層，而不只是一個標題；
     右欄則剛好容得下三張 183px 卡片加間距 */
    .em-wrap{grid-template-columns:minmax(260px,1fr) minmax(0,1.35fr);gap:0}
}
.em-head h2{font-size:clamp(30px,4.4vw,56px);line-height:1.2;letter-spacing:.04em}
/* 羅馬拼音副標：c-morinosato 用它在標題下墊一層，字距拉開、字級很小 */
.em-head .em-sub{
  margin:6px 0 0;font-family:var(--latin);font-size:12px;letter-spacing:.28em;
  color:var(--muted);
}
.em-head p{margin:12px 0 0;color:var(--muted);font-size:15px;line-height:1.8}

/* ── 緊急卡片網格 ── */
.em-cards{
  list-style:none;margin:0;padding:0;
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(10px,1.4vw,20px);
}
/* 三欄的門檻拉到 1150：900–1150 這段硬排三欄的話卡片只剩 133–160px、
   名稱全部折兩行；改排兩欄可以拿到 240px 以上 */
@media (width>=1150px){
  .em-cards{
    grid-template-columns:repeat(3,minmax(0,1fr));
    /* 寫在 base 規則之後：同特異度時後者勝，寫在前面會被上面的 padding:0 蓋掉 */
    border-left:.8px solid var(--line);padding-left:clamp(32px,5vw,86px);
  }
  #emergency .em-cards{border-left-color:var(--hair-dark)}
}
.em-card{
  /* 183×215 是量 c-morinosato 的結果；用 aspect-ratio 讓它在窄欄自動等比縮 */
  width:100%;aspect-ratio:183/215;min-height:150px;
  display:grid;grid-template-rows:1fr auto;justify-items:stretch;
  gap:10px;padding:18px 16px 14px;
  background:rgba(255,255,255,.06);border:.8px solid var(--hair-dark);border-radius:10px;
  color:inherit;font:inherit;cursor:pointer;text-align:center;
  transition:background-color .3s var(--ease),transform .3s var(--ease);
}
/* 淺色區塊裡（例如列印預覽外的一般情境）用紙色系，深色區塊才用半透明白 */
:root:not([data-theme="dark"]) .em-card{background:rgba(255,255,255,.06)}
.em-card:hover{background:rgba(255,255,255,.11)}
.em-card:active{transform:scale(.985)}
.em-icn{
  align-self:center;display:grid;place-items:center;
  width:clamp(56px,7vw,74px);aspect-ratio:1;border-radius:50%;
  background:rgba(255,255,255,.08);
}
.em-icn svg{width:52%;height:52%}
.em-name{
  /* 左對齊（照 c-morinosato），右邊留 22px 給箭頭。卡內可用寬因此是
     183 − 32 內距 − 22 = 129px，而最長的「台北駐福岡辦事處」在 15px 下是
     120px，剛好單行放得下；再大一級就會撞上箭頭 */
  align-self:end;width:100%;padding:10px 22px 0 0;
  border-top:.8px solid var(--hair-dark);
  font-size:15px;letter-spacing:.04em;line-height:1.45;text-align:left;
}
/* 箭頭疊在名稱那一列的右端，不另外佔一列（卡片高度是固定比例，省得下的每一 px 都要省） */
.em-card{position:relative}
.em-go{position:absolute;right:14px;bottom:12px;font-size:13px;opacity:.6}

/* ── 緊急彈窗 ── */
.em-dlg{
  width:min(420px,calc(100vw - 2*var(--gut)));padding:0;
  background:var(--card);color:var(--ink);
  border:.8px solid var(--line);border-radius:10px;
}
.em-dlg::backdrop{background:rgba(20,16,11,.55)}
.em-dlg-in{padding:clamp(20px,3.4vw,28px)}
.em-dlg h3{font-size:19px;line-height:1.5;letter-spacing:.03em}
.em-dlg .em-desc{margin:10px 0 0;font-size:15px;line-height:1.85;color:var(--muted)}
.em-meta{margin:14px 0 0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 14px;font-size:14px}
.em-meta dt{color:var(--muted);letter-spacing:.06em;white-space:nowrap}
.em-meta dd{margin:0;line-height:1.7}
.em-tel{
  display:flex;align-items:center;min-height:52px;margin-top:16px;
  font-family:var(--latin);font-size:26px;letter-spacing:.06em;
  text-decoration:none;border-bottom:.8px solid var(--line);
}
/* 待填：一條和號碼等寬的虛線，之後把號碼填進來版面不會跳 */
.em-tel.is-todo{gap:12px;border-bottom-style:none;color:var(--muted);cursor:default}
.em-todo-line{
  flex:0 0 auto;width:9ch;border-bottom:1.4px dashed var(--line);
  /* 9ch 約等於 13 碼號碼在 --latin 下的寬度 */
}
.em-todo-tag{font-family:var(--sans);font-size:13px;letter-spacing:.08em}
.em-close{
  margin-top:20px;width:100%;min-height:44px;
  background:var(--pine);color:var(--paper);border:0;border-radius:4px;
  font:inherit;font-size:15px;letter-spacing:.08em;cursor:pointer;
}

/* 沒有 JS 時 <dialog> 預設 display:none，緊急資訊會整份消失。
   退回成一般區塊，直接顯示在卡片下方——這是全頁唯一不能沒有的內容 */
.em-dlg:not([open]){display:block;position:static;margin:12px 0 0;width:auto}
.js .em-dlg:not([open]){display:none}
.em-close{display:none}
.js .em-close{display:block}
/* 沒有 JS 時卡片點了沒反應，把它降成純標示、不假裝可按 */
.em-card{}
html:not(.js) .em-card{cursor:default}

.em-print{display:none}

/* 保留原本的三欄文字列樣式：螢幕上不用，列印時整套接手 */
.emergency-grid{display:grid;gap:clamp(14px,2.2vh,26px)}
.em-row{display:grid;grid-template-columns:minmax(0,1fr);gap:2px}
@media (width>=560px){
  .em-row{grid-template-columns:minmax(11.5em,13em) minmax(0,1fr);gap:clamp(16px,2.4vw,34px);align-items:baseline}
}
.emergency-grid b,.emergency-grid p{text-wrap:pretty}
@media (width>=900px){ .emergency-grid b{white-space:nowrap} }
.emergency-grid b{font-size:15.5px;letter-spacing:.06em;color:var(--muted)}
.emergency-grid p{margin:0;font-size:16px;line-height:1.8}
.emergency-grid a.tel{
  display:inline-flex;align-items:center;min-height:40px;margin-top:2px;
  font-family:var(--latin);font-size:19px;letter-spacing:.06em;
  text-decoration:none;border-bottom:.8px solid var(--line);
}
@media (pointer:coarse){ .emergency-grid a.tel{min-height:44px} }

/* ── 花費 ── */
.recommendation{padding-top:clamp(22px,3.6vh,44px)}
/* 每天一列的明細表：編號、名稱、金額靠右。金額同欄右對齊才好直向比較 */
.pick-grid{display:grid;gap:0}
.pick-row{
  display:grid;grid-template-columns:auto minmax(0,1fr) auto;
  gap:clamp(12px,2.4vw,36px);align-items:baseline;
  border-top:.8px solid var(--line);padding-block:clamp(14px,2.2vh,22px);
}
.pick-row:last-child{border-bottom:.8px solid var(--line)}
.pick-no{
  font-family:var(--latin);font-size:14px;letter-spacing:.1em;color:var(--muted);
  white-space:nowrap;min-width:4.5em;
}
.pick-name{font-size:16px;line-height:1.7;letter-spacing:.04em}
.pick-amt{font-family:var(--latin);font-size:clamp(18px,1.8vw,22px);letter-spacing:.03em;
  white-space:nowrap;text-align:right}
.budget-stay{display:block;margin-top:2px;font-size:13.5px;color:var(--muted)}
@media (width<=560px){
  .pick-row{grid-template-columns:auto minmax(0,1fr);row-gap:4px}
  .pick-amt{grid-column:2;justify-self:end}
}
/* 合計：靠右、與明細拉開，是這一區的收束點。
   兩列用同一個格線，標題與金額各自對齊成一欄，字級也一致 */
.budget-lines{
  display:grid;grid-template-columns:auto auto;justify-content:end;align-items:baseline;
  column-gap:clamp(16px,3vw,40px);row-gap:clamp(6px,1.2vh,14px);
  margin-top:clamp(18px,3vh,34px);padding-block:clamp(12px,2vh,20px);
}
.budget-lines span{font-size:15px;letter-spacing:.04em;color:var(--muted);justify-self:end}
.budget-lines b{
  font-family:var(--latin);font-size:clamp(22px,2.8vw,32px);letter-spacing:.03em;
  justify-self:start;   /* 數字靠左起排，兩列的開頭才對得齊 */
}
/* 預算那行放進同一個格線的第二欄，開頭跟數字切齊 */
.budget-lines .pick-note{grid-column:2;margin:clamp(6px,1.2vh,12px) 0 0;text-align:left}
.over-tag{
  margin-left:.6em;color:var(--warm);border:.8px solid var(--warm);border-radius:4px;
  padding:1px 8px;font-size:13px;letter-spacing:.06em;
}
.pick-note{margin:clamp(10px,1.8vh,18px) 0 0;font-size:15px;line-height:1.85;color:var(--muted)}
.budget-empty{margin:clamp(14px,2.4vh,26px) 0 0;font-size:15px;line-height:1.85;color:var(--muted)}

/* ── 備忘 ── */
.check-grid{display:grid;gap:0}
.check-grid>div{
  display:flex;gap:clamp(14px,2.4vw,38px);align-items:baseline;
  border-top:.8px solid var(--line);padding-block:clamp(14px,2.2vh,24px);
  font-size:15.5px;line-height:1.85;
}
.check-grid>div:last-child{border-bottom:.8px solid var(--line)}
.check-grid span{font-family:var(--latin);font-size:14px;color:var(--muted);flex:0 0 auto}

/* ── 檢查（出發前清單）── */
/* 幾組並排，但不做成卡片：沿用全站的「無底色＋細線分隔」 */
.packing{
  display:grid;gap:clamp(20px,3vh,40px) clamp(28px,4vw,72px);
  grid-template-columns:repeat(auto-fit,minmax(min(100%,268px),1fr));
  align-items:start;
}
.pack-group h3{font-size:16px;letter-spacing:.1em;color:var(--muted);margin-bottom:10px}
.pack-items{list-style:none;margin:0;padding:0;display:grid;gap:0}
.pack-items li{border-top:.8px solid var(--line)}
.pack-items li:last-child{border-bottom:.8px solid var(--line)}
.pack-items label{
  display:flex;align-items:center;gap:14px;min-height:52px;font-size:16px;
  line-height:1.7;cursor:pointer;
}
.pack-items input{width:20px;height:20px;accent-color:var(--ink);flex:0 0 auto}
.pack-items input:checked+span{color:var(--muted);text-decoration:line-through}

/* ── 今日模式浮條 ── */
.now-bar{position:fixed;inset:auto 0 0;z-index:45;background:var(--ink);color:var(--paper)}
.now-inner{
  max-width:1440px;margin:0 auto;padding:12px var(--gut);
  display:flex;align-items:center;gap:14px;
}
.now-bar .lbl{flex:1 1 auto;min-width:0;font-size:15.5px;line-height:1.5;letter-spacing:.04em}
.now-bar .lbl small{
  display:block;font-family:var(--latin);font-size:12px;letter-spacing:.12em;opacity:.7;
}
.now-go{
  flex:0 0 auto;background:var(--paper);color:var(--ink);text-decoration:none;
  border-radius:4px;padding:0 14px;min-height:38px;display:grid;place-items:center;
  font-size:14px;letter-spacing:.06em;
}
.now-dismiss{
  flex:0 0 auto;background:none;border:.8px solid currentColor;border-radius:4px;color:inherit;
  font:inherit;min-width:38px;min-height:38px;cursor:pointer;
}

/* ── 頁內編輯器（?edit=1）── */
body.editing>*{display:none !important}
body.editing>#editor{display:block !important}
.editor{width:min(920px,100% - 40px);margin:0 auto;padding:28px 0 90px}
.ed-title{font-size:clamp(26px,5vw,38px);margin:0 0 6px;letter-spacing:.06em}
.ed-sub{color:var(--muted);margin:0 0 18px;line-height:1.8;max-width:60ch}
.ed-bar{
  position:sticky;top:0;z-index:5;display:flex;flex-wrap:wrap;gap:10px;align-items:center;
  padding:12px 0;margin-bottom:8px;background:var(--paper);border-bottom:.8px solid var(--line);
}
.ed-bar .spacer{flex:1}
.ed-btn{
  display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:10px 16px;
  border-radius:4px;border:.8px solid var(--line);background:var(--card);color:var(--ink);
  font:inherit;font-size:14px;cursor:pointer;text-decoration:none;
}
.ed-btn.primary{background:var(--pine);color:var(--paper);border-color:var(--pine)}
.ed-btn:hover{opacity:.9}
.ed-save{color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}
.ed-sec{border:.8px solid var(--line);border-radius:4px;background:var(--card);margin:16px 0;overflow:hidden}
.ed-sec>summary{cursor:pointer;list-style:none;padding:15px 20px;font-size:16px;background:var(--sage);letter-spacing:.06em}
.ed-sec>summary::-webkit-details-marker{display:none}
.ed-body{padding:16px 20px}
.ed-field{display:grid;gap:5px;margin-bottom:14px}
.ed-field label{font-size:13px;color:var(--muted);letter-spacing:.06em}
.ed-field input,.ed-field select,.ed-field textarea{
  font:inherit;font-size:14px;padding:10px 12px;border:.8px solid var(--line);border-radius:4px;
  background:var(--paper);color:var(--ink);width:100%;
}
.ed-field textarea{min-height:60px;resize:vertical}
.ed-row{border:.8px dashed var(--line);border-radius:4px;padding:14px;margin-bottom:12px}
.ed-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.ed-grid .full{grid-column:1/-1}
.ed-rowhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.ed-rowhead b{font-size:13px;color:var(--muted)}
.ed-del{
  background:none;border:.8px solid var(--line);border-radius:4px;color:var(--warm);
  font:inherit;font-size:12px;padding:8px 12px;cursor:pointer;min-height:36px;
}
.ed-add{
  background:none;border:.8px dashed var(--line);border-radius:4px;color:var(--ink);
  font:inherit;font-size:13px;padding:11px 14px;cursor:pointer;width:100%;min-height:44px;
}
.ed-daytitle{font-size:17px;margin:4px 0 10px;letter-spacing:.06em}
.ed-strrow{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:8px}
.ed-strrow textarea{
  font:inherit;font-size:14px;padding:10px 12px;border:.8px solid var(--line);border-radius:4px;
  background:var(--paper);color:var(--ink);min-height:46px;resize:vertical;
}
.draft-banner{
  width:min(920px,100% - 40px);margin:22px auto 0;background:var(--card);
  border:.8px solid var(--line);border-radius:4px;padding:14px 18px;
  display:flex;flex-wrap:wrap;gap:10px;align-items:center;
}
.draft-banner span{flex:1;font-size:14px;min-width:60%}
@media (width<=560px){.ed-grid{grid-template-columns:1fr}}

/* ── RWD ── */
@media (width<=640px){
  .stop{grid-template-columns:minmax(0,1fr);gap:2px}
}

/* ── 列印 ── */
@media print{
  /* 列印一律回到亮色 token，避免深色文字消失在白紙上 */
  :root[data-theme]{
    --paper:#fff;--ink:#2d2519;--line:#c9c7bf;--card:#fff;--muted:#5b554d;--warm:#8c2f22;
  }
  .sticky-nav,.now-bar,.pending-banner,.day-tools,.daybar,.loc,.go,.handoff,.skip{display:none}
  .band::before{background:#fff !important}
  .section{opacity:1 !important}
  /* 紙本印的是「計畫」不是「進度」，不帶今日狀態 */
  .stop.past{opacity:1}
  .stop.past>time{text-decoration:none}
  .stop.past h4,.stop.past h4 a{color:var(--ink)}
  .hero{min-height:0;padding:24px 0;grid-template-columns:1fr}
  /* 紙本不印封面照：整版滿版照片吃墨，而且紙上要的是資訊不是氣氛 */
  .card-deck,.hero-figure{display:none}
  /* 換日是螢幕上的行為；紙本必須印出全部天數 */
  .js .day:not(.is-on){display:block}
  .day{break-inside:auto;padding-top:18px}
  .day+.day{border-top:.8px solid var(--line);margin-top:18px}
  .stop{break-inside:avoid}
  /* 展開動畫在紙上沒有意義，且深色底會吃掉整桶碳粉 */
  #emergency{color:var(--ink);padding:24px 0}
  #emergency::before{display:none}
  #emergency>*{opacity:1}
  #emergency .em-head h2,#emergency .emergency-grid p,
  #emergency .emergency-grid a.tel{color:var(--ink)}
  #emergency .em-head p,#emergency .emergency-grid b{color:var(--muted)}
  #emergency .emergency-grid{border-left-color:var(--line)}
  #emergency .emergency-grid a.tel{border-bottom-color:var(--line)}
  /* 紙上換成三欄文字列：卡片網格是為了掃視與點擊，這兩件事在紙上都不存在，
     而六張卡各自展開五個欄位會把這一區從一頁撐成兩三頁 */
  .em-cards,.em-dlg{display:none !important}
  .em-print{display:block}
  .em-wrap{grid-template-columns:minmax(0,1fr) !important;gap:16px}
  .em-print .emergency-grid{border-left:0;padding-left:0}
  /* 列印用的是完整全名（「外交部旅外國人急難救助全球免付費專線」18 字），
     螢幕版的 nowrap 會讓它壓到右邊的說明欄，紙上必須允許折行 */
  .em-print .emergency-grid b{white-space:normal}
  /* 紙上沒得點，這句操作提示是廢話；後半句「境內撥號不需國碼」仍然有用所以留著 */
  .em-hint{display:none}
  .em-print-todo{color:var(--muted)}
  .em-row{break-inside:avoid}
  /* 提醒螢幕上預設收起，紙本由 beforeprint 展開；這裡只收掉多餘留白與「＋」 */
  .alerts-summary{padding-top:24px}
  .alerts-toggle{display:none}
  a{text-decoration:none;color:inherit}
  body{background:#fff}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  /* 只拿掉位移，保留底色變化：reduced-motion 要的是不要動，不是不要回饋 */
  .em-card{transition:background-color .3s var(--ease)}
  .em-card:active{transform:none}
}
</style>
</head>
<body>
<script id="trip-src" type="application/json">{{ data_json | safe }}</script>
<div class="editor" id="editor" hidden></div>

{#- 封面浮卡：行程項目裡的 live_status（自動抓的即時狀態）與 card（手寫的提醒卡）
    收成一疊，往左滑換下一張。即時狀態排前面（那是最需要一眼看到的），
    手寫卡再依行程順序接在後面。 -#}
{%- set ns = namespace(live_cards=[], note_cards=[]) -%}
{%- for day in days -%}
  {%- for item in day["items"] -%}
    {%- if item.live_status -%}
      {%- set ls = item.live_status -%}
      {#- 只留月日：卡片窄，時間對出發前查詢沒有幫助 -#}
      {%- set upd = (ls.updated[5:10] if ls.updated and ls.updated[:2] == "20" and ls.updated[4] == "-" else ls.updated) -%}
      {#- live_tag 放在 item 上（不是 live_status 裡）：每天自動更新會整包覆寫 live_status -#}
      {%- set _ = ns.live_cards.append({
        "title": ls.title_zh or item.name, "url": ls.source,
        "state": ls.status_zh or ls.status, "date": upd,
        "tag": item.live_tag, "body": ls.summary_zh or ls.detail,
        "hours": none}) -%}
    {%- elif item.card -%}
      {%- set _ = ns.note_cards.append({
        "title": item.card.title or item.name, "url": item.card.url,
        "state": item.card.text, "date": item.card.date,
        "tag": item.card.tag, "body": item.card["body"],
        "hours": item.card.hours}) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set cards = ns.live_cards + ns.note_cards -%}
<a class="skip" href="#itinerary">跳至行程</a>
<header class="hero">
  {#- 封面照 giftee.co.jp：左欄只有標語，沒有說明句、沒有 pills、沒有引導線。
      標語用小字＋極寬字距＋Regular 字重，刻意退到背景、把視覺讓給照片 -#}
  <div class="hero-copy">
    <h1>{{ trip.title }}</h1>
  </div>

  {# 照片內嵌成 data: URI，見 _hero_image.j2 的說明 #}
  {#- 不放出處行：Pexels 授權不強制標註，而這份只有家人會看。
      來源與授權記在 _hero_image.j2 的註解裡 -#}
  <figure class="hero-figure">
    <img src="{% include '_hero_image.j2' %}" width="800" height="1200"
         alt="高千穗峽真名井瀑布，一艘小船划過瀑布下方">
  </figure>

  {%- if cards %}
  <div class="card-deck" id="card-deck">
    {%- for c in cards %}
    <article class="card-live" data-i="{{ loop.index0 }}"{% if c.hours %} data-hours='{{ c.hours | tojson }}'{% endif %}>
      <div class="top">
        {%- if c.url %}
        <a class="who" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.title }}&nbsp;↗</a>
        {%- else %}
        <span class="who">{{ c.title }}</span>
        {%- endif %}
      </div>
      <p class="state">{{ c.state }}
        {%- if c.date %}<span class="upd">{{ c.date }}</span>{% endif %}
        {%- if c.tag %}<span class="live-tag">{{ c.tag }}</span>{% endif %}</p>
      {%- if c.body %}
      <p class="keys">{{ c.body }}</p>
      {%- endif %}
    </article>
    {%- endfor %}
  </div>
  {%- endif %}
</header>

<nav class="sticky-nav" aria-label="快速跳轉">
  <div class="nav-inner">
  {#- 「緊急」永遠留在列上、不收進抽屜：人在日本出事時要立刻按到，
      多一層漢堡就是多一次點擊。其餘四條在手機版收進抽屜 -#}
  <div class="nav-links">
    {% if trip.emergency %}<a class="nav-urgent" href="#emergency">緊急</a>{% endif %}
    <a href="#itinerary">行程</a>
    <a href="#budget">花費</a>
    {%- if notes %}<a href="#notes">提醒</a>{% endif %}
    {%- if trip.packing %}<a href="#packing">檢查</a>{% endif %}
  </div>
  <div class="nav-tools">
    <button class="tools-toggle" id="tools-toggle" type="button"
            aria-expanded="false" aria-controls="tools-menu" aria-label="開啟工具選單">
      <i></i><i></i><i></i>
    </button>
    <div class="tools-menu" id="tools-menu">
      {#- 手機版把導覽併進同一個抽屜，避免列上出現兩個一模一樣的漢堡鍵。
          桌機 display:none，所以不會被 Tab 走到，焦點數不變 -#}
      <div class="drawer-links">
        <a href="#itinerary">行程</a>
        <a href="#budget">花費</a>
        {%- if notes %}<a href="#notes">提醒</a>{% endif %}
        {%- if trip.packing %}<a href="#packing">檢查</a>{% endif %}
      </div>
      <button class="nav-tool" type="button" data-toggle="edit" aria-label="編輯行程資料">✎</button>
      <button class="nav-tool" type="button" data-toggle="theme" aria-pressed="false" aria-label="切換深色模式">🌙</button>
      <button class="nav-tool" type="button" data-toggle="size" aria-pressed="false" aria-label="切換大字模式">A⁺</button>
    </div>
  </div>
  </div>
</nav>

<main>
{% if pending %}
<div class="pending-banner">
  <details>
    <summary>⚠️ 還有 {{ pending | length }} 項待確認</summary>
    <ul>
    {% for p in pending %}
      <li><a href="#{{ p.anchor }}">{{ p.where }}</a> — {{ p.reason }}</li>
    {% endfor %}
    </ul>
  </details>
</div>
{% endif %}

{# ── 區塊 A：緊急（深色，臨時要用時最好找） ── #}
{% if trip.emergency %}
<section id="emergency">
  <div class="ov-inner">
    {# 版式參考 c-morinosato.com 的「診療案內」：左欄標題＋副標＋說明，右欄圖示卡片網格。
       卡片上只放名稱，說明與電話進彈窗——慌亂時網格要能一眼掃完，細節點開再看。
       原本的文字列版型保留在下方，只在列印時出現（見 @media print 的說明）。 #}
    <div class="em-wrap">
      <div class="em-head">
        <h2>緊急</h2>
        <p class="em-sub">EMERGENCY</p>
        <p><span class="em-hint">點任一項目看說明與電話。</span>日本境內撥號不需國碼。</p>
      </div>

      <ul class="em-cards">
      {% for e in trip.emergency %}
        <li>
          <button type="button" class="em-card" data-em="{{ loop.index0 }}"
                  aria-haspopup="dialog" aria-controls="em-dlg-{{ loop.index0 }}">
            <span class="em-icn">{{ em_icon(loop.index0) }}</span>
            <span class="em-name">{{ e.label }}</span>
            <span class="em-go" aria-hidden="true">→</span>
          </button>
        </li>
      {% endfor %}
      </ul>
    </div>

    {# 彈窗：原生 <dialog>，焦點鎖定與 Escape 由瀏覽器負責。
       沒有 JS 時 <dialog> 會被 CSS 改回一般區塊直接顯示——緊急資訊是全頁
       唯一不能因為 JS 沒跑就消失的內容。 #}
    {% for e in trip.emergency %}
    <dialog class="em-dlg" id="em-dlg-{{ loop.index0 }}" aria-labelledby="em-dlg-t-{{ loop.index0 }}">
      <div class="em-dlg-in">
        <h3 id="em-dlg-t-{{ loop.index0 }}">{{ e.name or e.label }}</h3>
        {% if e.desc %}<p class="em-desc">{{ e.desc }}</p>{% endif %}
        {%- if e.address or e.hours %}
        <dl class="em-meta">
          {%- if e.address %}<dt>地址</dt><dd>{{ e.address }}</dd>{% endif %}
          {%- if e.hours %}<dt>服務時間</dt><dd>{{ e.hours }}</dd>{% endif %}
        </dl>
        {%- endif %}
        {% if e.tel %}
        <a class="em-tel" href="tel:{{ e.tel }}">{{ e.tel }}</a>
        {% else %}
        {# 虛線佔位：保留 13 碼號碼的寬度，之後填進來版面不會跳 #}
        <p class="em-tel is-todo"><span class="em-todo-line"></span><span class="em-todo-tag">待填</span></p>
        {% endif %}
        <button type="button" class="em-close" data-em-close aria-label="關閉">關閉</button>
      </div>
    </dialog>
    {% endfor %}

    {# 只在紙上出現：卡片網格是為了掃視與點擊而設計，這兩件事在紙上都不存在，
       而六張卡各自展開五個欄位會把這一區撐成兩三頁。原本的三欄文字列最省紙。 #}
    <div class="em-print">
      <div class="emergency-grid">
      {% for e in trip.emergency %}
        <div class="em-row">
          <b>{{ e.name or e.label }}</b>
          <div class="em-val">
            {% if e.desc %}<p>{{ e.desc }}</p>{% endif %}
            {% if e.hours %}<p>服務時間：{{ e.hours }}</p>{% endif %}
            {% if e.address %}<p>{{ e.address }}</p>{% endif %}
            {% if e.tel %}<a class="tel" href="tel:{{ e.tel }}">{{ e.tel }}</a>
            {% else %}<p class="em-print-todo">電話：＿＿＿＿＿＿＿＿＿＿（出發前補上）</p>{% endif %}
          </div>
        </div>
      {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# ── 區塊 B：行程 ── #}
<div class="band band-b">
<section class="section" id="itinerary">
  <div class="section-heading">
    <h2>行程</h2>
  </div>

  <div class="days">
  {% for day in days %}
    <section class="day" id="day-{{ day.day_no }}" data-date="{{ day.date }}"
             {# 換日列上顯示的名字。主題那句在左欄已經有了，這裡只要「翻到第幾天」 #}
             data-theme-text="DAY {{ day.day_no }}"
             aria-label="Day {{ day.day_no }} {{ day.date_label }}">
      <div class="day-grid">
        <div class="day-aside">
          <b class="day-no">{{ "%02d" | format(day.day_no) }}
            <small>{{ day.date_label }} · {{ day.weekday }}</small>
          </b>
          <h3>{{ day.theme or "自由安排" }}</h3>
          {#- 左欄只留「當地氣候 + 當日小提醒」，整串景點鏈右邊的時間軸就看得到。
              weather_live 是氣象廳預報（scripts/update_weather.py 每天更新），只在
              行程進入 7 天預報範圍後才有；還沒有就顯示 trip.json 原本的氣候描述 -#}
          {% if day.weather_live %}
          <p class="day-weather">{{ day.weather_live.text }}
            <span class="wx-src">氣象廳{% if day.weather_live.scope %} {{ day.weather_live.scope }}{% endif %} · {{ day.weather_live.updated }} 發布</span>
          </p>
          {% elif day.weather %}<p class="day-weather">{{ day.weather }}</p>{% endif %}
          {% if day.note %}<p class="day-note">{{ day.note }}</p>{% endif %}
          {% if day.route_url %}
          <div class="day-tools">
            <a class="route-btn" href="{{ day.route_url }}" target="_blank" rel="noopener">本日路線一鍵導航</a>
            {% if day.route_capped %}<span class="route-cap">點位較多，僅串接前段</span>{% endif %}
          </div>
          {% endif %}
        </div>
      <ol class="timeline">
      {% for item in day["items"] %}
        <li class="stop {{ TYPE_META[item.type].cls if item.type in TYPE_META else '' }}" data-time="{{ item.time }}" data-name="{{ item.name }}"{% if item.map_url %} data-map="{{ item.map_url }}"{% endif %}>
          <time>{{ item.time }}</time>
          <div>
            <h4><span class="tico">{{ TYPE_META[item.type].icon if item.type in TYPE_META else '📍' }}</span>{% if item.url %}<a class="name" href="{{ item.url }}">{{ item.name }} ↗</a>{% else %}{{ item.name }}{% endif %}{% if item.map_url %} <a class="loc" href="{{ item.map_url }}">📍 地圖</a>{% endif %}{% for lk in item.links %} <a class="loc" href="{{ lk.url }}" target="_blank" rel="noopener">{{ lk.emoji }} {{ lk.label }}</a>{% endfor %}</h4>
            {% if item.note %}<p class="desc">{{ item.note }}</p>{% endif %}
            {# live_status 只出現在封面的浮卡，行程內不重複 #}
            {# 金額一律只出現在「花費」那一區，行程列表不重複寫價錢 #}
            {% set meta = [] %}
            {%- if item.duration %}{% set _ = meta.append("停留 " ~ item.duration) %}{% endif %}
            {%- if item.booking and item.booking.hours %}{% set _ = meta.append("營業 " ~ item.booking.hours) %}{% endif %}
            {% if meta or (item.booking and item.booking.code) %}
            <p class="meta">{{ meta | join(" · ") }}{% if item.booking and item.booking.code %}{% if meta %} · {% endif %}確認碼 <b>{{ item.booking.code }}</b>{% endif %}</p>
            {% endif %}
            {% if item.next_transit %}
              {% if item.transit_url %}<a class="go" href="{{ item.transit_url }}">→ {{ item.next_transit }} <span>導航 ↗</span></a>
              {% else %}<span class="go">→ {{ item.next_transit }}</span>{% endif %}
            {% endif %}
          </div>
        </li>
      {% endfor %}
      </ol>
      </div>
    </section>
  {% endfor %}
  </div>

  {# 換日列放在當天內容之後：看完一天才需要翻頁 #}
  <div class="daybar">
    <button class="arw" id="day-prev" type="button" aria-label="前一天">←</button>
    <span class="th" id="day-theme"></span>
    <button class="arw" id="day-next" type="button" aria-label="後一天">→</button>
  </div>

  {{ handoff("六天實際要花多少", "budget", "花費") }}
</section>

</div>{# /band-b #}
{# ── 區塊 C：花費 ── #}
<div class="band band-c">
<section class="section" id="budget">
  <div class="recommendation">
  <div class="section-heading">
    <h2>花費</h2>
    <p>每天一列，右側為當日小計。</p>
  </div>
  {% if totals.has_costs %}
  {# 每天一列，像明細一樣橫向排開；金額靠右對齊便於直向比較 #}
  <div class="pick-grid">
  {% for day in days %}
    <div class="pick-row">
      <span class="pick-no">DAY {{ "%02d" | format(day.day_no) }}</span>
      <span class="pick-name">{{ day.theme or "自由安排" }}
        {%- set stay = day["items"] | selectattr("type", "equalto", "住宿") | map(attribute="cost") | sum -%}
        {%- if stay %}<small class="budget-stay">住宿 {{ money(stay) }}</small>{% endif -%}
      </span>
      <b class="pick-amt">{{ money(day.subtotal) }}</b>
    </div>
  {% endfor %}
  {% set booking_cost = bookings | sum(attribute="cost") %}
  {% if booking_cost %}
    <div class="pick-row">
      <span class="pick-no">預付</span>
      <span class="pick-name">機票、住宿等預先付款項目</span>
      <b class="pick-amt">{{ money(booking_cost) }}</b>
    </div>
  {% endif %}
  </div>
  <div class="budget-lines">
    <span>總計{% if totals.over %} <span class="over-tag">超出預算 {{ money(totals.spent - totals.budget) }}</span>{% endif %}</span>
    <b>{{ money(totals.spent) }}{{ fx_alt(totals.spent) }}</b>
    <span>每人平均</span>
    <b>{{ money(totals.per_person) }}{{ fx_alt(totals.per_person) }}</b>
    {#- 大字只留合計與每人平均；類別占比那幾條移除，這裡用一行字交代預算餘裕 -#}
    {% if totals.over %}
    <p class="pick-note">預算 {{ money(totals.budget) }}，已超出 {{ money(totals.spent - totals.budget) }}，出發前再檢視一次大項花費。</p>
    {% else %}
    <p class="pick-note">預算 {{ money(totals.budget) }}，目前尚有 {{ money(totals.budget - totals.spent) }} 餘裕。</p>
    {% endif %}
  </div>
  {% else %}
  <div class="budget-lines">
    <span>預算</span>
    <b>{{ money(totals.budget) }}{{ fx_alt(totals.budget) }}</b>
  </div>
  <p class="budget-empty">花費尚未填入。待各項報價／確認金額後再逐筆補上，這裡會自動顯示合計與每人分攤。</p>
  {% endif %}
  </div>

  {%- if notes or trip.packing %}
  {{ handoff("出發前還有事要確認", ("notes" if notes else "packing"), ("提醒 · 檢查" if notes and trip.packing else ("提醒" if notes else "檢查"))) }}
  {%- endif %}
</section>
</div>{# /band-c #}
{# ── 區塊 E：提醒 + 檢查（出發前要看的都在同一帶） ── #}
{# 原本的「提醒」與「備忘」性質相同，合併成這一區；預設收起，點才展開 #}
<div class="band band-e">
{% if notes %}
<details class="section alerts-section" id="notes">
  <summary class="alerts-summary">
    <div class="section-heading">
      <h2>提醒</h2>
      <p>出發前該注意、該確認的事——設施異動、季節限定、訂位期限與當地潛規則。（共 {{ notes | length }} 則，點右側展開）</p>
    </div>
    <span class="alerts-toggle" aria-hidden="true">＋</span>
  </summary>
  <div class="alerts-body">
    <div class="check-grid">
    {% for n in notes %}
      <div><span>{{ "%02d" | format(loop.index) }}</span>{{ n }}</div>
    {% endfor %}
    </div>
  </div>
</details>
{% endif %}

{% if trip.packing %}
<section class="section" id="packing">
  <div class="section-heading">
    <h2>檢查</h2>
    <p>出發前一項一項勾，勾選狀態會記在這台裝置。</p>
  </div>
  <div class="packing">
  {% if trip.packing[0] is string %}
    <div class="pack-group">
      <ul class="pack-items">
      {% for it in trip.packing %}
        <li><label><input type="checkbox" data-pack="flat:{{ loop.index }}"><span>{{ it }}</span></label></li>
      {% endfor %}
      </ul>
    </div>
  {% else %}
    {% for group in trip.packing %}
    <div class="pack-group">
      {% if group.group %}<h3>{{ group.group }}</h3>{% endif %}
      <ul class="pack-items">
      {% for it in group["items"] %}
        <li><label><input type="checkbox" data-pack="{{ group.group }}:{{ loop.index }}"><span>{{ it }}</span></label></li>
      {% endfor %}
      </ul>
    </div>
    {% endfor %}
  {% endif %}
  </div>
</section>
{% endif %}

{#- 收尾：頁面原本在最後一個勾選框之後直接結束，像被裁掉。
    留在帶內吃同一個底色，只靠細線與字級差異區隔——為了首尾呼應再切一次
    底色，等於為了修辭犧牲連續性，而連續性正是要修的問題本身 -#}
<div class="coda">
  <div>
    <span class="d lat">{{ trip.range_label }}</span>
    <span class="t">{{ trip.title }}</span>
  </div>
</div>
</div>{# /band-e #}
</main>

<div class="now-bar" hidden>
  <div class="now-inner">
    <span class="lbl"></span>
    <a class="now-go" href="#" target="_blank" rel="noopener" hidden>導航 ↗</a>
    <button class="now-dismiss" type="button" aria-label="關閉今日模式">×</button>
  </div>
</div>

<script>
(function(){
  var strip = document.querySelector(".nav-links");
  var links = Array.prototype.slice.call(document.querySelectorAll(".sticky-nav a"));
  if (!strip || !links.length) return;
  var byId = {};
  links.forEach(function(a){ byId[a.hash.slice(1)] = a; });
  var current = links[0];
  current.classList.add("active");
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting && byId[e.target.id] && byId[e.target.id] !== current) {
        current.classList.remove("active");
        current = byId[e.target.id];
        current.classList.add("active");
        // 只水平捲動導覽列本身，絕不觸碰頁面捲動
        strip.scrollTo({
          left: current.offsetLeft - (strip.clientWidth - current.offsetWidth) / 2,
          behavior: reduce ? "auto" : "smooth"
        });
      }
    });
  }, {rootMargin:"-15% 0px -70% 0px"});
  Object.keys(byId).forEach(function(id){
    var el = document.getElementById(id);
    if (el) obs.observe(el);
  });

  // ── 換日：一次只顯示一天，左右鈕／鍵盤左右鍵切換 ──
  // 沒有 JS 時 CSS 讓所有天照常顯示（.js .day:not(.is-on){display:none}），不會整區消失
  var daysEls = Array.prototype.slice.call(document.querySelectorAll("section.day"));
  var prevBtn = document.getElementById("day-prev");
  var nextBtn = document.getElementById("day-next");
  var themeEl = document.getElementById("day-theme");
  var cur = 0;

  function showDay(n, focus){
    if (!daysEls.length) return;
    cur = Math.max(0, Math.min(daysEls.length - 1, n));
    daysEls.forEach(function(d, k){ d.classList.toggle("is-on", k === cur); });
    var d = daysEls[cur];
    if (themeEl){
      themeEl.textContent = d.getAttribute("data-theme-text") || "";
      // 今日徽章跟著當天走
      if (d.classList.contains("today")){
        var badge = document.createElement("span");
        badge.className = "today-badge";
        badge.textContent = "今日";
        themeEl.appendChild(badge);
      }
    }
    if (prevBtn) prevBtn.disabled = (cur === 0);
    if (nextBtn) nextBtn.disabled = (cur === daysEls.length - 1);
    // 換日後回到「行程」章節的頂端。按鈕在頁面下方，不捲回去的話
    // 換完會停在下一天的中段，看不到自己換到了哪一天
    if (focus){
      var sec = document.getElementById("itinerary");
      if (sec){
        var head = document.querySelector(".sticky-nav");
        var offset = head ? head.getBoundingClientRect().height : 0;
        var top = sec.getBoundingClientRect().top + window.scrollY - offset - 8;
        window.scrollTo({
          top: Math.max(0, top),
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
        });
      }
    }
  }
  function dayIndexOf(el){
    while (el && el !== document.body){
      var i = daysEls.indexOf(el);
      if (i > -1) return i;
      el = el.parentElement;
    }
    return -1;
  }
  if (prevBtn) prevBtn.addEventListener("click", function(){ showDay(cur - 1, true); });
  if (nextBtn) nextBtn.addEventListener("click", function(){ showDay(cur + 1, true); });
  document.addEventListener("keydown", function(e){
    // e.target 可能是 document（頁面剛載入、還沒點過任何東西），它沒有 closest
    var t = e.target;
    if (t && t.closest && t.closest("input,textarea,select,[contenteditable]")) return;
    if (e.altKey || e.ctrlKey || e.metaKey) return;   // 別跟 Alt+← 上一頁搶
    if (e.key === "ArrowLeft")  showDay(cur - 1);
    if (e.key === "ArrowRight") showDay(cur + 1);
  });
  showDay(0);

  // 連到某天（待確認清單的 #day-N）時切到那一天
  function openHash(hash){
    if (!hash || hash.length < 2) return;
    var el;
    try { el = document.querySelector(hash); } catch (err) { return; }
    if (!el) return;
    var i = dayIndexOf(el);
    if (i > -1) showDay(i);
  }
  links.forEach(function(a){
    a.addEventListener("click", function(){ openHash(a.hash); });
  });
  window.addEventListener("hashchange", function(){ openHash(location.hash); });
  openHash(location.hash);

  // 列印：紙本要印出全部天數（換日只是螢幕上的行為），提醒區也一併展開
  var printedAll = false;
  window.addEventListener("beforeprint", function(){
    printedAll = true;
    daysEls.forEach(function(d){ d.classList.add("is-on"); });
    var al = document.getElementById("notes");
    if (al && al.tagName === "DETAILS") al.open = true;
  });
  window.addEventListener("afterprint", function(){
    if (!printedAll) return;
    printedAll = false;
    showDay(cur);   // 列印完把畫面收回單日
  });

  // ── 今日模式：依裝置時鐘標出今天、灰階已過行程、浮出「下一站」 ──
  function todayMode(now){
    var y = now.getFullYear();
    var pad = function(n){ return String(n).padStart(2, "0"); };
    var today = y + "-" + pad(now.getMonth() + 1) + "-" + pad(now.getDate());
    var nowHM = pad(now.getHours()) + ":" + pad(now.getMinutes());
    var dayEl = document.querySelector('section.day[data-date="' + today + '"]');
    var bar = document.querySelector(".now-bar");
    if (!dayEl || !bar) return;

    // 今天在行程裡：直接切到那一天，徽章由 showDay 貼在日期列上
    dayEl.classList.add("today");
    var idx = daysEls.indexOf(dayEl);
    if (idx > -1) showDay(idx);

    var next = null;
    Array.prototype.forEach.call(dayEl.querySelectorAll(".stop"), function(s){
      var t = s.getAttribute("data-time");
      if (t && t < nowHM) s.classList.add("past");
      else if (!next && t) next = s;
    });

    var dayNo = (dayEl.id || "").replace("day-", "");
    var lbl = bar.querySelector(".lbl");
    var go = bar.querySelector(".now-go");
    if (next) {
      lbl.innerHTML = "<small>DAY " + dayNo + " · 進行中</small>下一站 " +
        next.getAttribute("data-time") + " " + next.getAttribute("data-name");
      var map = next.getAttribute("data-map");
      if (map) { go.href = map; go.hidden = false; } else { go.hidden = true; }
    } else {
      lbl.innerHTML = "<small>DAY " + dayNo + "</small>今日行程已全部結束";
      go.hidden = true;
    }

    var dismissKey = "nowbar-dismissed:" + location.pathname + ":" + today;
    try { if (localStorage.getItem(dismissKey) === "1") return; } catch (e) {}
    bar.hidden = false;
    document.body.style.paddingBottom = bar.offsetHeight + "px";
    // 浮卡也要讓開：兩者都是 fixed 且都貼底，浮條 z-45 會蓋掉浮卡底部
    document.documentElement.style.setProperty("--nowbar-h", bar.offsetHeight + "px");
    bar.querySelector(".now-dismiss").addEventListener("click", function(){
      bar.hidden = true;
      document.body.style.paddingBottom = "";
      document.documentElement.style.removeProperty("--nowbar-h");
      Array.prototype.forEach.call(dayEl.querySelectorAll(".stop.past"), function(s){
        s.classList.remove("past");
      });
      try { localStorage.setItem(dismissKey, "1"); } catch (e) {}
    });
  }
  // 可用 ?today=2026-10-16 或 ?today=2026-10-16T14:30 模擬日期，方便預覽今日模式
  var override = new URLSearchParams(location.search).get("today");
  if (override && /^\d{4}-\d{2}-\d{2}/.test(override)) {
    todayMode(new Date(override.length === 10 ? override + "T12:00:00" : override));
  } else {
    todayMode(new Date());
  }

  // 深色 / 大字 切換（偏好記在 localStorage；亮色與一般字為預設）
  var root = document.documentElement;
  var themeBtn = document.querySelector('[data-toggle="theme"]');
  var sizeBtn = document.querySelector('[data-toggle="size"]');
  function syncTools(){
    if (themeBtn){
      var dark = root.getAttribute("data-theme") === "dark";
      themeBtn.setAttribute("aria-pressed", dark ? "true" : "false");
      themeBtn.textContent = dark ? "☀️" : "🌙";
      themeBtn.setAttribute("aria-label", dark ? "切換淺色模式" : "切換深色模式");
    }
    if (sizeBtn){
      var large = root.getAttribute("data-theme-size") === "large";
      sizeBtn.setAttribute("aria-pressed", large ? "true" : "false");
    }
  }
  syncTools();
  if (themeBtn) themeBtn.addEventListener("click", function(){
    var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) {}
    syncTools();
  });
  if (sizeBtn) sizeBtn.addEventListener("click", function(){
    var large = root.getAttribute("data-theme-size") === "large";
    if (large){ root.removeAttribute("data-theme-size"); }
    else { root.setAttribute("data-theme-size", "large"); }
    try { localStorage.setItem("textsize", large ? "normal" : "large"); } catch (e) {}
    syncTools();
  });
  var editBtn = document.querySelector('[data-toggle="edit"]');
  if (editBtn) editBtn.addEventListener("click", function(){
    window.open(location.pathname + "?edit=1", "_blank");
  });

  // 所有外部連結一律另開分頁（# 頁內跳轉維持原分頁）
  Array.prototype.forEach.call(document.querySelectorAll("a[href]"), function(a){
    var h = a.getAttribute("href") || "";
    if (h && h.charAt(0) !== "#") { a.target = "_blank"; a.rel = "noopener"; }
  });

  // ── 工具列：三顆鈕收在三條線圖示裡 ──
  var toolsToggle = document.getElementById("tools-toggle");
  var toolsMenu = document.getElementById("tools-menu");
  if (toolsToggle && toolsMenu) {
    toolsMenu.hidden = true;
    var setTools = function(open){
      toolsMenu.hidden = !open;
      toolsToggle.setAttribute("aria-expanded", open ? "true" : "false");
      toolsToggle.setAttribute("aria-label", open ? "關閉工具選單" : "開啟工具選單");
    };
    toolsToggle.addEventListener("click", function(e){
      e.stopPropagation();
      setTools(toolsMenu.hidden);
    });
    // 點外面或按 Esc 收起來
    document.addEventListener("click", function(e){
      if (!toolsMenu.hidden && !toolsMenu.contains(e.target) && e.target !== toolsToggle) setTools(false);
    });
    document.addEventListener("keydown", function(e){
      if (e.key === "Escape" && !toolsMenu.hidden) { setTools(false); toolsToggle.focus(); }
    });
  }

  // ── 緊急卡片彈窗 ──
  // 用原生 <dialog>.showModal()：焦點鎖定、Escape 關閉、背景 inert 都由瀏覽器負責，
  // 不用自己寫 focus trap。舊瀏覽器沒有 showModal 就退回錨點行為（內容仍在頁面上）
  [].slice.call(document.querySelectorAll(".em-card")).forEach(function (btn) {
    btn.addEventListener("click", function () {
      var dlg = document.getElementById(btn.getAttribute("aria-controls"));
      if (!dlg) return;
      if (typeof dlg.showModal === "function") { dlg.showModal(); }
      else { dlg.setAttribute("open", ""); dlg.scrollIntoView({block: "nearest"}); }
    });
  });
  [].slice.call(document.querySelectorAll("[data-em-close]")).forEach(function (b) {
    b.addEventListener("click", function () {
      var dlg = b.closest("dialog");
      if (dlg) { if (typeof dlg.close === "function") dlg.close(); else dlg.removeAttribute("open"); }
    });
  });
  // 點背景關閉：<dialog> 的點擊事件在 backdrop 上也會觸發，且 target 會是 dialog 本身
  [].slice.call(document.querySelectorAll(".em-dlg")).forEach(function (dlg) {
    dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
  });

  // ── 封面浮卡：載入時浮出，開始往下捲就退場；多張時疊成一疊，往左滑換下一張 ──
  var liveCard = document.getElementById("card-deck");
  if (liveCard) {
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){ liveCard.classList.add("is-in"); });
    });
    // 保險：rAF 在分頁未渲染時不會回呼，浮卡會永遠停在 opacity:0
    setTimeout(function(){ liveCard.classList.add("is-in"); }, 400);
  }

  var deckCards = liveCard ? [].slice.call(liveCard.querySelectorAll(".card-live")) : [];
  if (deckCards.length > 1) {
    var deckCur = 0, dots = [];
    // 疊法：最上面那張正常顯示，後面的往上縮一階，只露出邊
    function layout(dx){
      var n = deckCards.length;
      deckCards.forEach(function(card, i){
        var pos = (i - deckCur + n) % n;
        var depth = Math.min(pos, 2);
        card.style.setProperty("--dy", (-7 * depth) + "px");
        card.style.setProperty("--sc", (1 - 0.035 * depth).toFixed(3));
        card.style.setProperty("--op", pos === 0 ? "1" : (depth === 1 ? ".78" : ".5"));
        card.style.setProperty("--z", String(n - depth));
        card.setAttribute("aria-hidden", pos === 0 ? "false" : "true");
        // aria-hidden 的卡片仍然可以 Tab 到，讀屏與鍵盤會不一致 —— 一併移出 Tab 序
        Array.prototype.forEach.call(card.querySelectorAll("a"), function(lk){
          if (pos === 0) lk.removeAttribute("tabindex"); else lk.setAttribute("tabindex","-1");
        });
        // 拖曳中只有最上面那張跟著手指走
        if (pos === 0 && dx) {
          card.style.transform = "translate3d(" + dx + "px,0,0)";
        } else {
          card.style.transform = "";
        }
      });
      dots.forEach(function(d, i){ d.setAttribute("aria-current", i === deckCur ? "true" : "false"); });
    }
    function go(step){
      deckCur = (deckCur + step + deckCards.length) % deckCards.length;
      layout(0);
    }

    // 頁碼點：桌機沒有滑動手勢時也能換卡
    var dotWrap = document.createElement("div");
    dotWrap.className = "deck-dots";
    deckCards.forEach(function(card, i){
      var b = document.createElement("button");
      b.type = "button";
      b.setAttribute("aria-label", "顯示第 " + (i + 1) + " 張卡");
      b.addEventListener("click", function(){ deckCur = i; layout(0); });
      dotWrap.appendChild(b);
      dots.push(b);
    });
    liveCard.appendChild(dotWrap);

    // 手勢：水平拖曳超過門檻就換卡；沒超過就彈回。
    // 直向的拖曳交還給頁面捲動（touch-action:pan-y 已允許）
    var x0 = null, y0 = null, dx = 0, dragging = false;
    liveCard.addEventListener("pointerdown", function(e){
      if (e.target.closest("a") || e.target.closest("button")) return;
      x0 = e.clientX; y0 = e.clientY; dx = 0; dragging = false;
    });
    liveCard.addEventListener("pointermove", function(e){
      if (x0 === null) return;
      var mx = e.clientX - x0, my = e.clientY - y0;
      if (!dragging) {
        if (Math.abs(mx) < 6 || Math.abs(mx) < Math.abs(my)) return;
        dragging = true;
        deckCards.forEach(function(c){ c.classList.add("is-dragging"); });
        if (liveCard.setPointerCapture) { try { liveCard.setPointerCapture(e.pointerId); } catch (err) {} }
      }
      dx = mx;
      layout(dx);
    });
    function endDrag(){
      if (x0 === null) return;
      x0 = null; y0 = null;
      deckCards.forEach(function(c){ c.classList.remove("is-dragging"); });
      if (dragging && Math.abs(dx) > 44) { go(dx < 0 ? 1 : -1); } else { layout(0); }
      dragging = false; dx = 0;
    }
    liveCard.addEventListener("pointerup", endDrag);
    liveCard.addEventListener("pointercancel", endDrag);
    liveCard.addEventListener("pointerleave", endDrag);
    layout(0);
  }

  // ── 有 data-hours 的卡片：看「今天（日本時間）有沒有營業」──
  // 只判斷當天，不管此刻幾點；靜態頁可能隔幾天才打開，所以在瀏覽器端算。
  deckCards.forEach(function(card){
    var raw = card.getAttribute("data-hours");
    if (!raw) return;
    var spec;
    try { spec = JSON.parse(raw); } catch (err) { return; }
    var stateEl = card.querySelector(".state");
    if (!stateEl || !stateEl.firstChild || stateEl.firstChild.nodeType !== 3) return;
    var label = stateEl.firstChild;
    function openToday(){
      // 取日本當地日期：把 toLocaleString 的結果再解析回 Date
      var d = new Date(new Date().toLocaleString("en-US", {timeZone: "Asia/Tokyo"}));
      var mmdd = ("0" + (d.getMonth() + 1)).slice(-2) + "-" + ("0" + d.getDate()).slice(-2);
      if ((spec.closed || []).indexOf(mmdd) > -1) return false;
      return ((spec.open || {})[String(d.getDay())] || []).length > 0;
    }
    function paint(){ label.nodeValue = openToday() ? "正常營業" : "休息"; }
    paint();
    // 跨日才需要重算：回到分頁時對一次就夠
    document.addEventListener("visibilitychange", function(){
      if (!document.hidden) paint();
    });
  });

  // ── 固定頂列底色 + 深色花費色帶隨捲動展開 ──
  var head = document.querySelector(".sticky-nav");
  var ov = document.getElementById("emergency");
  // 底色展開掛在「帶」上；內容淡入改掛在「章節」上，
  // 這樣同一帶裡的第二個章節（檢查）也會等捲到才出現，動畫一致
  var bands = [].slice.call(document.querySelectorAll(".band"));
  if (ov) bands.push(ov);
  var fades = [].slice.call(document.querySelectorAll("main .section"));
  if (ov) fades.push(ov);
  // 使用者要求減少動態時完全不碰 --open/--fade，兩者的 CSS 預設值就是「已展開」
  var wantsMotion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function clamp01(v){ return v < 0 ? 0 : v > 1 ? 1 : v; }
  // 緊急色塊左右內縮的實際 px。用 calc() 定義，讀不到數值，
  // 所以量 ::before 的 used value，並只在載入與改變視窗大小時重算
  var emInset = 0;
  // 導覽實際佔位的兩個元素（連結群、工具鍵）
  var navInk = head ? [head.querySelector(".nav-links"), head.querySelector(".nav-tools")] : null;
  if (navInk && (!navInk[0] || !navInk[1])) navInk = null;
  function measureInset(){
    if (!ov) return;
    emInset = parseFloat(getComputedStyle(ov, "::before").left) || 0;
  }
  measureInset();
  window.addEventListener("resize", measureInset);

  function syncScroll(){
    // 導覽改成永遠透明、位置固定之後，原本每次捲動都要跑一輪
    // getBoundingClientRect + getComputedStyle 的「取背景色」迴圈整個不需要了，
    // .stuck 這個 class 也沒有任何規則在用。
    if (liveCard) liveCard.classList.toggle("is-out", window.scrollY > 120);
    // 導覽壓在深色塊上時只翻文字顏色。桌機上色塊內縮量綁著導覽的版心，
    // 兩者永遠分開、這裡一律 false；真正會用到的是手機版（色塊近乎滿版）。
    // 寫成 rect 判斷而不是寫死斷點，之後版面再動也不會失效
    if (head && ov && navInk){
      var er = ov.getBoundingClientRect();
      // 用實際看得見的連結與工具鍵，不能用 .sticky-nav——它是 width:100% 的
      // 透明容器，橫向永遠和色塊重疊，判斷會恆為 true
      var a = navInk[0].getBoundingClientRect(), b = navInk[1].getBoundingClientRect();
      var nT = Math.min(a.top, b.top), nB = Math.max(a.bottom, b.bottom);
      var nL = Math.min(a.left, b.left), nR = Math.max(a.right, b.right);
      var overlap = er.top < nB && er.bottom > nT &&
                    (er.left + emInset) < nR && (er.right - emInset) > nL;
      head.classList.toggle("over-dark", overlap);
    }

    if (!wantsMotion) return;
    var vh = window.innerHeight;
    // 左右展開只留給深色花費區；其餘區塊一律底色滿版，只做內容淡入
    if (ov){
      var od = ov.getBoundingClientRect();
      var maxInset = window.innerWidth <= 760 ? 12 : 22;  // 窄螢幕別縮掉太多可視寬度
      var op = clamp01((vh - od.top) / (vh * 0.65));
      ov.style.setProperty("--open", (maxInset * (1 - op)).toFixed(2) + "%");
    }
    for (var j = 0; j < fades.length; j++){
      var fe = fades[j], fd = fe.getBoundingClientRect();
      var fp = clamp01((vh - fd.top) / (vh * 0.65));
      // 0.08 而非 0.35：章節頂端一進到畫面就開始亮（95%），72% 時全亮。
      // 用 0.35 的話要等頂端降到 77% 才開始，畫面底部會固定有 22.75% 是
      // 「有內容但看不見」，捲動時讀起來就是一段一段斷開的
      fe.style.setProperty("--fade", clamp01((fp - 0.08) / 0.35).toFixed(3));
    }
  }
  // 直接同步，不繞 requestAnimationFrame：rAF 在分頁切到背景時不會回呼，
  // 一旦 --fade 已被設為 0 就再也改不回來，深色花費整區會永遠透明
  window.addEventListener("scroll", syncScroll, {passive:true});
  window.addEventListener("resize", syncScroll);
  document.addEventListener("visibilitychange", syncScroll);
  window.addEventListener("beforeprint", function(){
    // 紙本不做展開動畫。沒有這段，未捲到的章節會整片印成空白
    if (ov) ov.style.setProperty("--open","0%");
    fades.forEach(function(el){ el.style.setProperty("--fade","1"); });
  });
  syncScroll();

  // 檢查清單勾選狀態存 localStorage（依本頁路徑分隔）
  var packBoxes = document.querySelectorAll("input[data-pack]");
  packBoxes.forEach(function(box){
    var key = "pack:" + location.pathname + ":" + box.getAttribute("data-pack");
    try { box.checked = localStorage.getItem(key) === "1"; } catch (e) {}
    box.addEventListener("change", function(){
      try { localStorage.setItem(key, box.checked ? "1" : "0"); } catch (e) {}
    });
  });

})();
</script>

<script>
/* ── 頁內編輯器：?edit=1 顯示表單，自動存草稿到 localStorage，可匯出 trip.json ── */
(function(){
  var srcEl = document.getElementById("trip-src");
  if (!srcEl) return;
  var baked;
  try { baked = JSON.parse(srcEl.textContent); } catch (e) { return; }
  var draftKey = "draft:" + location.pathname;
  var editing = new URLSearchParams(location.search).get("edit") === "1";

  function loadDraft(){ try { var d = localStorage.getItem(draftKey); return d ? JSON.parse(d) : null; } catch (e) { return null; } }

  // 手冊模式：偵測未匯出的本機草稿 → 橫幅提醒
  if (!editing) {
    if (!loadDraft()) return;
    var main = document.querySelector("main");
    if (!main) return;
    var bn = document.createElement("div");
    bn.className = "draft-banner";
    var sp = document.createElement("span");
    sp.textContent = "📝 偵測到本機編輯草稿（尚未匯出成 trip.json）";
    var open = document.createElement("a");
    open.className = "ed-btn"; open.href = location.pathname + "?edit=1"; open.target = "_blank"; open.rel = "noopener";
    open.textContent = "開啟編輯器";
    var disc = document.createElement("button");
    disc.className = "ed-btn"; disc.textContent = "捨棄草稿";
    disc.addEventListener("click", function(){
      if (confirm("捨棄本機草稿？此手冊顯示的內容不受影響。")) {
        try { localStorage.removeItem(draftKey); } catch (e) {}
        bn.remove();
      }
    });
    bn.appendChild(sp); bn.appendChild(open); bn.appendChild(disc);
    main.insertBefore(bn, main.firstChild);
    return;
  }

  // ── 編輯模式 ──
  document.body.classList.add("editing");
  document.title = "編輯｜" + document.title;
  var data = loadDraft() || JSON.parse(JSON.stringify(baked));
  var host = document.getElementById("editor");
  host.hidden = false;
  var saveEl, saveTimer = null;

  function save(){
    try {
      localStorage.setItem(draftKey, JSON.stringify(data));
      if (saveEl) saveEl.textContent = "已存草稿 " + new Date().toLocaleTimeString();
    } catch (e) { if (saveEl) saveEl.textContent = "存檔失敗（瀏覽器空間不足？）"; }
  }
  function touch(){ clearTimeout(saveTimer); saveTimer = setTimeout(save, 400); }

  function field(obj, key, label, opts){
    opts = opts || {};
    var wrap = document.createElement("div");
    wrap.className = "ed-field" + (opts.full ? " full" : "");
    var l = document.createElement("label"); l.textContent = label; wrap.appendChild(l);
    var inp;
    if (opts.type === "textarea") { inp = document.createElement("textarea"); }
    else if (opts.type === "select") {
      inp = document.createElement("select");
      (opts.opts || []).forEach(function(o){
        var op = document.createElement("option"); op.value = o; op.textContent = o || "（無）"; inp.appendChild(op);
      });
    } else { inp = document.createElement("input"); inp.type = opts.type || "text"; }
    var v = obj[key];
    inp.value = (v === undefined || v === null) ? "" : v;
    inp.addEventListener(opts.type === "select" ? "change" : "input", function(){
      var val = inp.value;
      if (opts.type === "number") { obj[key] = val === "" ? 0 : Number(val); }
      else if (val === "") { delete obj[key]; }
      else { obj[key] = val; }
      touch();
    });
    wrap.appendChild(inp); return wrap;
  }
  function grid(){ var g = document.createElement("div"); g.className = "ed-grid"; return g; }

  function listEditor(arr, buildRow, addLabel, makeNew){
    var box = document.createElement("div");
    function redraw(){
      box.innerHTML = "";
      arr.forEach(function(item, i){
        var row = document.createElement("div"); row.className = "ed-row";
        var head = document.createElement("div"); head.className = "ed-rowhead";
        var b = document.createElement("b"); b.textContent = "# " + (i + 1); head.appendChild(b);
        var del = document.createElement("button"); del.className = "ed-del"; del.type = "button"; del.textContent = "刪除";
        del.addEventListener("click", function(){ arr.splice(i, 1); touch(); redraw(); });
        head.appendChild(del); row.appendChild(head);
        buildRow(item, row); box.appendChild(row);
      });
      var add = document.createElement("button"); add.className = "ed-add"; add.type = "button"; add.textContent = addLabel;
      add.addEventListener("click", function(){ arr.push(makeNew()); touch(); redraw(); });
      box.appendChild(add);
    }
    redraw(); return box;
  }

  function stringListEditor(arr){
    var box = document.createElement("div");
    function redraw(){
      box.innerHTML = "";
      arr.forEach(function(s, i){
        var row = document.createElement("div"); row.className = "ed-strrow";
        var inp = document.createElement("textarea"); inp.value = s;
        inp.addEventListener("input", function(){ arr[i] = inp.value; touch(); });
        var del = document.createElement("button"); del.className = "ed-del"; del.type = "button"; del.textContent = "刪除";
        del.addEventListener("click", function(){ arr.splice(i, 1); touch(); redraw(); });
        row.appendChild(inp); row.appendChild(del); box.appendChild(row);
      });
      var add = document.createElement("button"); add.className = "ed-add"; add.type = "button"; add.textContent = "＋ 新增一項";
      add.addEventListener("click", function(){ arr.push(""); touch(); redraw(); });
      box.appendChild(add);
    }
    redraw(); return box;
  }

  function section(title, open, build){
    var det = document.createElement("details"); det.className = "ed-sec"; det.open = !!open;
    var sum = document.createElement("summary"); sum.textContent = title; det.appendChild(sum);
    var body = document.createElement("div"); body.className = "ed-body"; build(body); det.appendChild(body);
    host.appendChild(det);
  }

  function cleanExport(){
    var d = JSON.parse(JSON.stringify(data));
    var t = d.trip || {};
    if (t.fx && !(Number(t.fx.rate) > 0)) delete t.fx;
    ["emergency", "packing"].forEach(function(k){ if (Array.isArray(t[k]) && !t[k].length) delete t[k]; });
    ["notes", "bookings"].forEach(function(k){ if (Array.isArray(d[k]) && !d[k].length) delete d[k]; });
    return d;
  }

  // 標題 + 說明 + 工具列
  var title = document.createElement("h1"); title.className = "ed-title"; title.textContent = "編輯行程資料";
  var sub = document.createElement("p"); sub.className = "ed-sub";
  sub.textContent = "邊改邊自動存到這台裝置。改好可「匯出 trip.json」下載，或「複製 JSON」直接貼到雲端 repo 的 trip.json；更新 trip.json 後重新渲染，手冊就會套用。";
  host.appendChild(title); host.appendChild(sub);

  var bar = document.createElement("div"); bar.className = "ed-bar";
  var exportBtn = document.createElement("button"); exportBtn.type = "button"; exportBtn.className = "ed-btn primary"; exportBtn.textContent = "⬇ 匯出 trip.json";
  var copyBtn = document.createElement("button"); copyBtn.type = "button"; copyBtn.className = "ed-btn"; copyBtn.textContent = "📋 複製 JSON";
  var resetBtn = document.createElement("button"); resetBtn.type = "button"; resetBtn.className = "ed-btn"; resetBtn.textContent = "還原草稿";
  var backBtn = document.createElement("button"); backBtn.type = "button"; backBtn.className = "ed-btn"; backBtn.textContent = "← 回到手冊";
  saveEl = document.createElement("span"); saveEl.className = "ed-save";
  bar.appendChild(exportBtn); bar.appendChild(copyBtn); bar.appendChild(resetBtn); bar.appendChild(backBtn);
  var spacer = document.createElement("span"); spacer.className = "spacer"; bar.appendChild(spacer);
  bar.appendChild(saveEl);
  host.appendChild(bar);

  exportBtn.addEventListener("click", function(){
    save();
    var blob = new Blob([JSON.stringify(cleanExport(), null, 2) + "\n"], {type: "application/json"});
    var a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "trip.json";
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ URL.revokeObjectURL(a.href); }, 1000);
  });
  copyBtn.addEventListener("click", function(){
    save();
    var text = JSON.stringify(cleanExport(), null, 2) + "\n";
    function flash(msg){
      copyBtn.textContent = msg;
      setTimeout(function(){ copyBtn.textContent = "📋 複製 JSON"; }, 2000);
    }
    function fallback(){
      try {
        var ta = document.createElement("textarea");
        ta.value = text; ta.style.position = "fixed"; ta.style.top = "0"; ta.style.opacity = "0";
        document.body.appendChild(ta); ta.focus(); ta.select();
        var ok = document.execCommand("copy"); ta.remove();
        flash(ok ? "✓ 已複製" : "複製失敗，請手動選取");
      } catch (e) { flash("複製失敗，請手動選取"); }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function(){ flash("✓ 已複製"); }, fallback);
    } else {
      fallback();
    }
  });
  resetBtn.addEventListener("click", function(){
    if (confirm("還原成手冊目前的原始資料，並清除本機草稿？")) {
      try { localStorage.removeItem(draftKey); } catch (e) {}
      location.reload();
    }
  });
  backBtn.addEventListener("click", function(){ location.href = location.pathname; });

  var ITEM_TYPES = ["景點", "餐廳", "交通", "住宿", "購物"];
  var STATUS = ["", "confirmed", "pending"];

  // 旅程 meta
  section("旅程", true, function(body){
    var t = data.trip = data.trip || {};
    var g = grid();
    g.appendChild(field(t, "title", "標題", {full: true}));
    g.appendChild(field(t, "destination", "目的地", {full: true}));
    g.appendChild(field(t, "start_date", "開始日期", {type: "date"}));
    g.appendChild(field(t, "end_date", "結束日期", {type: "date"}));
    g.appendChild(field(t, "travelers", "人數", {type: "number"}));
    g.appendChild(field(t, "currency", "幣別（如 NT$／¥）"));
    g.appendChild(field(t, "budget", "總預算", {type: "number"}));
    body.appendChild(g);
    var fxTitle = document.createElement("div"); fxTitle.className = "ed-daytitle"; fxTitle.textContent = "雙幣別換算（選填）"; body.appendChild(fxTitle);
    t.fx = t.fx || {};
    var fg = grid();
    fg.appendChild(field(t.fx, "currency", "換算幣別"));
    fg.appendChild(field(t.fx, "rate", "匯率（金額 × 此值）", {type: "number"}));
    body.appendChild(fg);
  });

  // 每日行程
  section("每日行程", false, function(body){
    data.days = data.days || [];
    body.appendChild(listEditor(data.days, function(day, row){
      var g = grid();
      g.appendChild(field(day, "date", "日期", {type: "date"}));
      g.appendChild(field(day, "theme", "主題"));
      g.appendChild(field(day, "weather", "天氣／穿著", {full: true}));
      g.appendChild(field(day, "note", "當日小提醒", {full: true}));
      row.appendChild(g);
      var lbl = document.createElement("div"); lbl.className = "ed-daytitle"; lbl.textContent = "行程項目（請依時間排序）"; row.appendChild(lbl);
      day.items = day.items || [];
      row.appendChild(listEditor(day.items, function(item, irow){
        var ig = grid();
        ig.appendChild(field(item, "time", "時間", {type: "time"}));
        ig.appendChild(field(item, "type", "類型", {type: "select", opts: ITEM_TYPES}));
        ig.appendChild(field(item, "name", "名稱", {full: true}));
        ig.appendChild(field(item, "note", "備註", {type: "textarea", full: true}));
        ig.appendChild(field(item, "duration", "停留（如 1.5h）"));
        ig.appendChild(field(item, "cost", "費用", {type: "number"}));
        ig.appendChild(field(item, "map_query", "地圖搜尋字串"));
        ig.appendChild(field(item, "next_transit", "到下一站的交通"));
        ig.appendChild(field(item, "url", "連結", {full: true}));
        ig.appendChild(field(item, "status", "狀態", {type: "select", opts: STATUS}));
        irow.appendChild(ig);
      }, "＋ 新增行程項目", function(){ return {time: "09:00", name: "新項目", type: "景點"}; }));
    }, "＋ 新增一天", function(){ return {date: (data.trip && data.trip.start_date) || "", theme: "", items: []}; }));
  });

  // 預付項目（手冊已不單獨列出訂位，但金額仍計入花費）
  section("預付項目（機票／住宿等，只計花費）", false, function(body){
    data.bookings = data.bookings || [];
    body.appendChild(listEditor(data.bookings, function(b, row){
      var g = grid();
      g.appendChild(field(b, "type", "類型（航班／飯店…）"));
      g.appendChild(field(b, "name", "名稱"));
      g.appendChild(field(b, "date", "日期", {type: "date"}));
      g.appendChild(field(b, "time", "時間", {type: "time"}));
      g.appendChild(field(b, "code", "確認碼"));
      g.appendChild(field(b, "cost", "費用", {type: "number"}));
      g.appendChild(field(b, "note", "備註", {type: "textarea", full: true}));
      g.appendChild(field(b, "url", "連結", {full: true}));
      g.appendChild(field(b, "status", "狀態", {type: "select", opts: STATUS}));
      row.appendChild(g);
    }, "＋ 新增預付項目", function(){ return {type: "飯店", name: ""}; }));
  });

  // 緊急資訊
  section("緊急資訊", false, function(body){
    var t = data.trip = data.trip || {};
    t.emergency = t.emergency || [];
    body.appendChild(listEditor(t.emergency, function(e, row){
      var g = grid();
      g.appendChild(field(e, "label", "名稱", {full: true}));
      g.appendChild(field(e, "value", "說明／地址"));
      g.appendChild(field(e, "tel", "電話（可一鍵撥號）"));
      row.appendChild(g);
    }, "＋ 新增緊急聯絡", function(){ return {label: "", value: "", tel: ""}; }));
  });

  // 檢查清單（trip.packing）
  section("檢查清單", false, function(body){
    var t = data.trip = data.trip || {};
    var pk = t.packing;
    if (pk && pk.length && typeof pk[0] === "string") {
      body.appendChild(stringListEditor(pk));
    } else {
      t.packing = pk || [];
      body.appendChild(listEditor(t.packing, function(grp, row){
        row.appendChild(field(grp, "group", "分組名稱"));
        grp.items = grp.items || [];
        var lbl = document.createElement("div"); lbl.className = "ed-daytitle"; lbl.textContent = "項目"; row.appendChild(lbl);
        row.appendChild(stringListEditor(grp.items));
      }, "＋ 新增分組", function(){ return {group: "新分組", items: []}; }));
    }
  });

  // 提醒（原本的提醒與備忘已合併成一份 notes）
  section("提醒（出發前該注意、該確認的事）", false, function(body){
    data.notes = data.notes || [];
    body.appendChild(stringListEditor(data.notes));
  });
})();
</script>

<script>
/* PWA：僅在 http/https 下註冊 service worker；file:// 單檔開啟時略過，不影響離線單檔用法 */
if ("serviceWorker" in navigator && location.protocol.indexOf("http") === 0) {
  window.addEventListener("load", function(){
    // 記住載入時是否已被舊版 SW 控制：首次安裝為 false，用來避免第一次進站誤重整
    var hadController = !!navigator.serviceWorker.controller;
    navigator.serviceWorker.register("sw.js").then(function(reg){
      if (reg && reg.update) { try { reg.update(); } catch (e) {} }  // 每次開啟主動查有無新版
    }).catch(function(){});
    // 新版 SW 接管後自動重整一次，讓主畫面 App 不用手動刷就看到新內容
    var refreshing = false;
    navigator.serviceWorker.addEventListener("controllerchange", function(){
      if (refreshing || !hadController) return;  // 首次安裝（本來沒有 controller）不重整
      refreshing = true;
      location.reload();
    });
  });
  // 從背景喚醒（切回主畫面 App）時再查一次更新，抓到就會走上面的自動重整
  document.addEventListener("visibilitychange", function(){
    if (document.visibilityState === "visible" && navigator.serviceWorker.controller) {
      navigator.serviceWorker.getRegistration().then(function(reg){
        if (reg && reg.update) { try { reg.update(); } catch (e) {} }
      }).catch(function(){});
    }
  });
}
</script>
</body>
</html>
